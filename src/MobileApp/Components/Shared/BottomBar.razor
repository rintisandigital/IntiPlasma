@implements IDisposable
@inject NavigationManager Navigation
@inject SyncEngine Sync
@inject ApprovalsApi Approvals

@* Template "menubar-footer": first four available features + Lainnya (AppFeatures.BottomBar). *@
<div class="menubar-footer footer-fixed">
    <ul class="inner-bar">
        @foreach (AppFeature feature in AppFeatures.BottomBar(User))
        {
            <li class="@(IsActive(feature) ? "active" : null)">
                <a href="@feature.Route">
                    <div class="icon">
                        <i class="@feature.Icon"></i>
                        @if (feature == AppFeatures.SyncQueue && _queued > 0)
                        {
                            <span class="bar-badge">@(_queued > 99 ? "99+" : _queued)</span>
                        }
                        @if (feature == AppFeatures.Approvals && _waiting > 0)
                        {
                            <span class="bar-badge">@(_waiting > 99 ? "99+" : _waiting)</span>
                        }
                    </div>
                    <div class="text-caption-3 text">@feature.Title</div>
                </a>
            </li>
        }
    </ul>
</div>

@code {
    [Parameter, EditorRequired]
    public CurrentUser User { get; set; } = default!;

    private int _queued;
    private int _waiting;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Sync.Changed += OnQueueChanged;
        await CountAsync();
        await CountApprovalsAsync();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Sync.Changed -= OnQueueChanged;
    }

    /// <summary>
    /// Entries of the offline queue not sent yet (badge on "Antrean").
    /// </summary>
    private async Task CountAsync() =>
        _queued = AppFeatures.SyncQueue.IsAvailable(User) ? await Sync.CountAsync() : 0;

    private void OnQueueChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            await CountAsync();
            StateHasChanged();
        });

    private bool IsActive(AppFeature feature)
    {
        string path = new Uri(Navigation.Uri).AbsolutePath;

        if (feature.Route == "/")
        {
            return path == "/";
        }

        if (feature == AppFeatures.More)
        {
            // Pages opened from "Lainnya" keep it highlighted.
            return path == feature.Route
                || AppFeatures.MoreMenu(User).Any(f => path.StartsWith(f.Route, StringComparison.OrdinalIgnoreCase));
        }

        return path.StartsWith(feature.Route, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Requests waiting for the user (badge on "Approval", M-92); kept when offline.
    /// </summary>
    private async Task CountApprovalsAsync()
    {
        if (!AppFeatures.Approvals.IsAvailable(User))
        {
            return;
        }

        ApiResult<ApprovalInboxCount> result = await Approvals.GetInboxCountAsync();
        if (result.IsSuccess)
        {
            _waiting = result.Value.Total;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            StateHasChanged();
            await CountApprovalsAsync();
            StateHasChanged();
        });
}
