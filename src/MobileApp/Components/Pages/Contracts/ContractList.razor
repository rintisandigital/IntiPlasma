@page "/kontrak"
@inject PartnershipApi Partnership

@* Kontrak kemitraan of the branch (PLAN-MOBILE §6.2; contracts follow the branch scope, M-38). *@
<AppPage Title="Kontrak" BackTo="/lainnya">
    <SearchBox Placeholder="Cari kode atau nama kontrak" OnSearch="SearchAsync" />

    <select class="form-select filter-select mb-12" aria-label="Status" @onchange="StatusChangedAsync">
        <option value="">Semua status</option>
        <option value="Active">Aktif</option>
        <option value="Draft">Draf</option>
        <option value="Inactive">Nonaktif</option>
    </select>

    <LoaderList Loader="_loader" EmptyText="Belum ada kontrak." EmptyIcon="icon-bookTxt"
                OnLoadMore="() => _loader.LoadMoreAsync()" OnRetry="() => _loader.ReloadAsync()">
        <ItemTemplate Context="contract">
            <a class="list-card" href="/kontrak/@contract.Id">
                <div class="d-flex justify-content-between align-items-start gap-8">
                    <div>
                        <div class="text-caption-2 text-Primary">@contract.Code · @Labels.Scheme(contract.Scheme)</div>
                        <div class="text-button-small text-OnSurface">@contract.Name</div>
                    </div>
                    <StatusBadge Text="@Labels.ContractStatus(contract.Status)" Tone="@Labels.ContractTone(contract.Status)" />
                </div>
                <div class="meta">
                    <span><i class="icon icon-calendar"></i>@Period(contract)</span>
                </div>
            </a>
        </ItemTemplate>
    </LoaderList>
</AppPage>

@code {
    private PagedLoader<Contract> _loader = default!;
    private string? _search;
    private string? _status;

    protected override Task OnInitializedAsync()
    {
        _loader = new PagedLoader<Contract>((page, ct) => Partnership.GetContractsAsync(_search, page, _status, ct));

        return _loader.ReloadAsync();
    }

    private Task SearchAsync(string? search)
    {
        _search = search;

        return _loader.ReloadAsync();
    }

    private Task StatusChangedAsync(ChangeEventArgs e)
    {
        _status = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value.ToString();

        return _loader.ReloadAsync();
    }

    internal static string Period(Contract contract) =>
        contract.ValidTo is { } to
            ? $"{IdFormat.Date(contract.ValidFrom)} – {IdFormat.Date(to)}"
            : $"Mulai {IdFormat.Date(contract.ValidFrom)}";
}
