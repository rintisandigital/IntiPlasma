@page "/pengajuan"
@inject ApprovalsApi Approvals

@* Pengajuan Saya (PLAN-MOBILE §6.2, M-92): status & level berjalan; batal selama menunggu dari halaman detail. *@
<AppPage Title="Pengajuan Saya" BackTo="/lainnya">
    <div class="segmented mb-12">
        @foreach ((string? key, string title) in Statuses)
        {
            <button type="button" class="@(_status == key ? "active" : null)" @onclick="() => SelectAsync(key)">@title</button>
        }
    </div>

    <LoaderList Loader="_loader" EmptyText="Belum ada pengajuan." EmptyIcon="icon-timeline"
                OnLoadMore="() => _loader.LoadMoreAsync()" OnRetry="() => _loader.ReloadAsync()">
        <ItemTemplate Context="request">
            <a class="list-card" href="/approval/@request.Id">
                <div class="d-flex justify-content-between align-items-start gap-8">
                    <div>
                        <div class="text-caption-2 text-Primary">@Labels.ApprovalDocumentType(request.DocumentType)</div>
                        <div class="text-button-small text-OnSurface">@request.DocumentCode — @request.DocumentTitle</div>
                    </div>
                    <StatusBadge Text="@Labels.ApprovalStatus(request.Status)" Tone="@Labels.ApprovalTone(request.Status)" />
                </div>
                <div class="text-caption-2 text-dark-4 mt-4">
                    @Labels.ApprovalLevel(request.Status, request.CurrentLevel, request.LevelCount, request.CurrentLevelName)
                    · @IdFormat.DateTime(request.RequestedAtUtc.ToLocalTime())
                </div>
                @if (request.RejectReason is not null)
                {
                    <div class="text-caption-2 text-Red mt-4">Alasan: @request.RejectReason</div>
                }
            </a>
        </ItemTemplate>
    </LoaderList>
</AppPage>

@code {
    private static readonly (string? Key, string Title)[] Statuses =
    [
        (null, "Semua"),
        ("Pending", "Menunggu"),
        ("Rejected", "Ditolak"),
        ("Approved", "Disetujui")
    ];

    private PagedLoader<ApprovalRequest> _loader = default!;
    private string? _status;

    protected override Task OnInitializedAsync()
    {
        _loader = new PagedLoader<ApprovalRequest>((page, ct) => Approvals.GetMineAsync(_status, page, ct));

        return _loader.ReloadAsync();
    }

    private Task SelectAsync(string? status)
    {
        _status = status;

        return _loader.ReloadAsync();
    }
}
