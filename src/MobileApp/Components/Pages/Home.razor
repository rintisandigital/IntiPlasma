@page "/"
@inject SessionService Session
@inject RecordingService Recordings

@* Dashboard (PLAN-MOBILE §6.2). M0 shows the user and the menu; the role-specific content comes in M4. *@
@if (Session.User is { } user)
{
    <div class="header-avt fixed-top">
        <img class="header-logo-text" src="images/rdi-logo-text.png" alt="Rintisan Digital Indopiranti" />
    </div>

    <div class="app-content style-2">
        <div class="tf-container pt-16 pb-16">
            <div class="hero-card">
                <div class="text-caption-1 muted">@IdFormat.Greeting(DateTime.Now),</div>
                <div class="text-title fw-6 mt-4">@user.FullName</div>
                <div class="text-caption-2 muted mt-4">@IdFormat.LongDate(DateOnly.FromDateTime(DateTime.Now))</div>
                <div class="d-flex flex-wrap gap-8 mt-12">
                    @if (user.MainBranch is { } branch)
                    {
                        <span class="chip"><i class="icon icon-buildings"></i>@branch.Name</span>
                    }
                    @foreach (string role in user.Roles)
                    {
                        <span class="chip">@role</span>
                    }
                </div>
            </div>

            @if (_queued > 0)
            {
                <a class="list-card highlight mt-16" href="/antrean">
                    <div class="d-flex justify-content-between align-items-center gap-8">
                        <div>
                            <div class="text-button-small text-OnSurface">@_queued data belum terkirim</div>
                            <div class="text-caption-2 text-dark-4">Dikirim otomatis saat online. Ketuk untuk melihat antrean.</div>
                        </div>
                        <i class="icon icon-upload"></i>
                    </div>
                </a>
            }

            <h5 class="mt-24 mb-12">Menu</h5>
            <div class="feature-grid">
                @foreach (AppFeature feature in MenuTiles(user))
                {
                    <a class="feature-tile" href="@feature.Route">
                        <i class="icon @feature.Icon"></i>
                        <span>@feature.Title</span>
                    </a>
                }
            </div>

            <p class="text-caption-2 text-dark-4 mt-20">
                Fitur aplikasi dirilis bertahap. Menu yang belum tersedia menampilkan jadwal fasenya.
            </p>
        </div>
    </div>
}

@code {
    private int _queued;

    protected override async Task OnInitializedAsync() => _queued = (await Recordings.GetLocalListAsync()).Count;

    private static IEnumerable<AppFeature> MenuTiles(CurrentUser user) =>
        AppFeatures.All.Where(f =>
            f.Phase is not null
            && f != AppFeatures.Home
            && f != AppFeatures.More
            && f.IsAvailable(user));
}
