@inherits LayoutComponentBase
@implements IDisposable
@inject SessionService Session
@inject NavigationManager Navigation
@inject MobileApp.Core.Abstractions.IConnectivity Connectivity

@* Layout of every page after sign-in: page content (header included) + bottom bar from permissions (§6.1). *@
@if (Session is { IsSignedIn: true, User: { } user })
{
    <div class="@(_online ? null : "is-offline")">
        @if (!_online)
        {
            <div class="app-banner offline">Offline — data yang tampil dari penyimpanan perangkat</div>
        }

        @Body

        <BottomBar User="user" />
    </div>
}

@code {
    private bool _online = true;

    protected override void OnInitialized()
    {
        _online = Connectivity.IsOnline;
        Connectivity.Changed += OnConnectivityChanged;
    }

    protected override void OnParametersSet()
    {
        if (!Session.IsSignedIn)
        {
            Navigation.NavigateTo("/login", replace: true);
        }
    }

    public void Dispose() => Connectivity.Changed -= OnConnectivityChanged;

    private void OnConnectivityChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(() =>
        {
            _online = Connectivity.IsOnline;
            StateHasChanged();
        });
}
