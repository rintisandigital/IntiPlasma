@* Header branch selector (template "select-store" dropdown). mainboard.js relies on .branch-switcher,
   data-switch-url, .active-branch-name and [data-branch-id]/[data-branch-name]. *@
@model BranchSwitcherModel
@if (Model.Branches.Count == 0 && !Model.AllBranchesAllowed)
{
    <li class="nav-item nav-item-box me-2">
        <span class="badge bg-warning text-dark" title="Ask your administrator for branch access">No branch access</span>
    </li>
}
else
{
    <li class="nav-item dropdown has-arrow main-drop select-store-dropdown branch-switcher"
        data-switch-url="@Url.Action("SwitchBranch", "Main")">
        <a href="javascript:void(0);" class="dropdown-toggle nav-link select-store" data-bs-toggle="dropdown" title="Active branch">
            <span class="user-info">
                <span class="user-detail">
                    <span class="user-name">
                        <i class="ti ti-building-store"></i>&nbsp; <span class="active-branch-name">@(Model.Active?.Name ?? "All Branches")</span>
                    </span>
                </span>
            </span>
        </a>
        <div class="dropdown-menu dropdown-menu-right">
            @if (Model.AllBranchesAllowed)
            {
                <a href="javascript:void(0);" class="dropdown-item @(Model.Active is null ? "active" : "")"
                   data-branch-id="" data-branch-name="All Branches">
                    <i class="ti ti-building-store"></i>&nbsp; All Branches
                </a>
            }
            @foreach (Application.Users.GetCurrent.CurrentUserBranch branch in Model.Branches)
            {
                <a href="javascript:void(0);" class="dropdown-item @(Model.Active?.Id == branch.Id ? "active" : "")"
                   data-branch-id="@branch.Id" data-branch-name="@branch.Name" title="@branch.Code">
                    <i class="ti ti-building-store"></i>&nbsp; @branch.Name
                </a>
            }
        </div>
    </li>
}
