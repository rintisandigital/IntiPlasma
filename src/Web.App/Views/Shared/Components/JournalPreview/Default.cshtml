@* Journals of a business document (PLAN-WEBAPP §21.2), from JournalPreviewViewComponent:
   a "Journal" button for the page-header actions that opens the journals in a modal. *@
@model Web.App.ViewComponents.JournalPreviewModel
<button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#journal-modal">
    <i class="ti ti-book me-1"></i>Journal
    @if (Model.Journals.Count > 0)
    {
        <span class="badge bg-secondary ms-1">@Model.Journals.Count</span>
    }
</button>
<div class="modal fade journal-preview" id="journal-modal" tabindex="-1" aria-labelledby="journal-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="journal-modal-title"><i class="ti ti-book me-1"></i>Journal</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (Model.Journals.Count == 0)
                {
                    <div class="text-muted p-3">@Model.EmptyText</div>
                }
                <div class="table-responsive">
                    @foreach (Application.Finance.Journals.JournalResponse journal in Model.Journals)
                    {
                        <table class="table table-sm mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th colspan="2">
                                        <a asp-area="Finance" asp-controller="Journals" asp-action="Details" asp-route-id="@journal.Id">@(journal.Number ?? "(draft)")</a>
                                        <span class="fw-normal text-muted ms-2">@Fmt.Date(journal.Date) · @journal.Description</span>
                                    </th>
                                    <th class="text-end">Debit</th><th class="text-end">Credit</th>
                                    <th class="text-end" style="width: 1%"><partial name="Partials/_StatusBadge" model="journal.Status" /></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (Application.Finance.Journals.JournalLineResponse line in journal.Lines ?? [])
                                {
                                    <tr>
                                        <td class="@(line.Credit > 0 ? "ps-4" : "")">@line.AccountCode — @line.AccountName</td>
                                        <td class="text-muted">@(line.CostCenterCode ?? "")</td>
                                        <td class="text-end text-nowrap">@(line.Debit == 0 ? "" : Fmt.Money(line.Debit))</td>
                                        <td class="text-end text-nowrap">@(line.Credit == 0 ? "" : Fmt.Money(line.Credit))</td>
                                        <td></td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="2" class="text-end">Total</th>
                                    <th class="text-end text-nowrap">@Fmt.Money((journal.Lines ?? []).Sum(l => l.Debit))</th>
                                    <th class="text-end text-nowrap">@Fmt.Money((journal.Lines ?? []).Sum(l => l.Credit))</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
