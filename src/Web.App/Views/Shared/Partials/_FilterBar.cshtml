@* Search box of a list page; keeps the other query string filters and resets paging. *@
@model FilterBarModel
<form method="get" class="search-set">
    @foreach (KeyValuePair<string, Microsoft.Extensions.Primitives.StringValues> parameter in ViewContext.HttpContext.Request.Query)
    {
        if (parameter.Key is "search" or "page")
        {
            continue;
        }
        <input type="hidden" name="@parameter.Key" value="@parameter.Value" />
    }
    <div class="search-input">
        <input type="search" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="@Model.Placeholder" aria-label="@Model.Placeholder">
        <span class="btn-searchset"><i class="ti ti-search fs-14"></i></span>
    </div>
</form>
