@model FormButtonsModel
<div class="d-flex gap-2 mb-4">
    @if (Model.CanSave)
    {
        <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>@Model.SaveText</button>
    }
    <a href="@Model.CancelUrl" class="btn btn-light">@(Model.CanSave ? "Cancel" : "Back")</a>
</div>
