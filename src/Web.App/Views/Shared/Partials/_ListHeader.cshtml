@model ListHeaderModel
<div class="page-header">
    <div class="add-item d-flex">
        <div class="page-title">
            <h4 class="fw-bold">@Model.Title</h4>
            <h6>@Model.Subtitle</h6>
        </div>
    </div>
    <partial name="Partials/_ExportButtons" model="Model.MenuCode" />
    @if (Model.AddText is not null)
    {
        <div class="page-btn">
            <a asp-action="Create" asp-menu="@Model.MenuCode" asp-right="Create" class="btn btn-primary">
                <i class="ti ti-circle-plus me-1"></i>@Model.AddText
            </a>
        </div>
    }
</div>
