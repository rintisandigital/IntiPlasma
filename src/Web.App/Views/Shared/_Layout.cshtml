@* Layout of every page shown inside the mainboard's content iframe (no header/sidebar). PLAN-WEBAPP §3.10. *@
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    string appName = AppSettings.Value.Name;
    string? title = ViewData["Title"] as string;
    string? success = TempData[AppController.SuccessKey] as string;
    string? error = TempData[AppController.ErrorKey] as string;
}
<!DOCTYPE html>
<html lang="en" data-theme="light" data-color="primary" data-mainboard-url="@Url.Action("Index", "Main")">
<head>
    <base href="~/">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrEmpty(title) ? appName : $"{title} - {appName}")</title>

    <script src="~/js/frame.js" asp-append-version="true"></script>

    <link rel="icon" type="image/svg+xml" href="~/img/logo-small.svg">
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/plugins/fontawesome/css/fontawesome.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/plugins/fontawesome/css/all.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/plugins/tabler-icons/tabler-icons.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/plugins/sweetalert2/sweetalert2.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/plugins/jquery.toast/jquery.toast.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/style.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="frame-page" data-menu="@ViewData["Menu"]" data-session-expires="@SessionExpiry.ForScript(Context)" data-csrf-token="@Antiforgery.GetAndStoreTokens(Context).RequestToken">

    <div id="page-notice" hidden data-success="@success" data-error="@error"></div>

    <div class="frame-content">
        @RenderBody()
    </div>

    <script src="~/assets/plugins/jquery/jquery-4.0.0.min.js" asp-append-version="true"></script>
    <script src="~/js/jquery-compat.js" asp-append-version="true"></script>
    <script src="~/assets/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/assets/js/feather.min.js" asp-append-version="true"></script>
    <script src="~/assets/plugins/sweetalert2/sweetalert2.min.js" asp-append-version="true"></script>
    <script src="~/assets/plugins/jquery.toast/jquery.toast.min.js" asp-append-version="true"></script>
    <script src="~/assets/js/script.js" asp-append-version="true"></script>
    <script src="~/assets/plugins/tom-select/js/tom-select.complete.min.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/js/lookup.js" asp-append-version="true"></script>
    <script src="~/js/collection.js" asp-append-version="true"></script>
    <script src="~/js/item-units.js" asp-append-version="true"></script>
    <script src="~/js/attachments.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
