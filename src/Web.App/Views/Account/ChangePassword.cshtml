@model Web.App.Models.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["Menu"] = "account.password";
}
<partial name="Partials/_PageHeader" model='new PageHeaderModel("Change Password", "Other sessions and mobile sign-ins will have to sign in again")' />

<div class="row">
    <div class="col-xl-6 col-lg-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="ChangePassword" method="post" autocomplete="off">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password">
                        <span asp-validation-for="CurrentPassword" class="text-danger fs-13"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password">
                        <span asp-validation-for="NewPassword" class="text-danger fs-13"></span>
                        <div class="form-text">At least 8 characters.</div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password">
                        <span asp-validation-for="ConfirmPassword" class="text-danger fs-13"></span>
                    </div>

                    <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>Change Password</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
