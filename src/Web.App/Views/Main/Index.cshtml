@* Mainboard: header + two-column sidebar + content iframe. Pages open in the iframe (PLAN-WEBAPP §3.10). *@
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = null;
    string appName = AppSettings.Value.Name;
}
<!DOCTYPE html>
<html lang="en" data-theme="light" data-sidebar="light" data-color="primary" data-topbar="white" data-layout="twocolumn" data-width="fluid">
<head>
    <base href="~/">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>@appName</title>

    <link rel="icon" type="image/svg+xml" href="~/img/logo-small.svg">
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/plugins/fontawesome/css/fontawesome.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/plugins/fontawesome/css/all.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/plugins/tabler-icons/tabler-icons.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/plugins/simplebar/simplebar.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/style.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true">
</head>
<body class="mainboard"
      data-app-title="@appName"
      data-home-url="@Url.Action("Dashboard", "Main")"
      data-csrf-token="@Antiforgery.GetAndStoreTokens(Context).RequestToken"
      data-session-expires="@SessionExpiry.ForScript(Context)"
      data-keep-alive-url="@Url.Action("KeepAlive", "Main")"
      data-login-url="@Url.Action("Login", "Auth")">

    <div id="global-loader">
        <div class="whirly-loader"></div>
    </div>

    <div class="main-wrapper">

        <partial name="Mainboard/_Header" />

        <vc:sidebar />

        <div class="page-wrapper pagehead d-flex flex-column justify-content-between">
            <div class="frame-loader" aria-hidden="true">
                <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading…</span></div>
            </div>
            <div class="flex-grow-1 p-2">
                <iframe name="content-frame" class="content-frame" title="Content"></iframe>
            </div>
        </div>
    </div>

    <div class="modal fade" id="session-modal" tabindex="-1" aria-labelledby="session-modal-title" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="session-modal-title">Your session is about to expire</h5>
                </div>
                <div class="modal-body">
                    <p class="mb-0">You will be signed out at <strong id="session-expires-at"></strong> because of inactivity. Unsaved changes will be lost.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" id="session-keep-alive">Stay signed in</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/assets/plugins/jquery/jquery-4.0.0.min.js" asp-append-version="true"></script>
    <script src="~/js/jquery-compat.js" asp-append-version="true"></script>
    <script src="~/assets/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/assets/js/feather.min.js" asp-append-version="true"></script>
    <script src="~/assets/plugins/simplebar/simplebar.min.js" asp-append-version="true"></script>
    <script src="~/assets/js/script.js" asp-append-version="true"></script>
    <script src="~/js/mainboard.js" asp-append-version="true"></script>
</body>
</html>
