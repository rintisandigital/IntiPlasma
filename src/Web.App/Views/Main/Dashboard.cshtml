@{
    ViewData["Title"] = "Dashboard";
    ViewData["Menu"] = "dashboard";
}
<partial name="Partials/_PageHeader" model='new PageHeaderModel("Dashboard", $"Welcome, {User.GetDisplayName()}")' />

<div class="card">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3">
            <span class="avatar-initials avatar-lg">@User.GetInitials()</span>
            <div>
                <h5 class="mb-1">@AppSettings.Value.Name — Admin Office</h5>
                <p class="mb-0 text-muted">
                    Modules appear in the sidebar as they are released. Use the branch selector in the header to
                    choose the default branch of every page.
                </p>
            </div>
        </div>
    </div>
</div>
