@model Web.App.Models.Auth.LoginViewModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Sign In";
    string mainboardUrl = Url.Action("Index", "Main")!;
    string loginUrl = Url.Action("Login", "Auth")!;
}
@section HeadScripts {
    <script>
        // A session that expired inside the content iframe lands here in the frame: sign in on the whole window
        // and come back to the same page afterwards (PLAN-WEBAPP §3.10).
        (function () {
            if (window.top === window.self) { return; }
            var returnUrl = new URLSearchParams(window.location.search).get('ReturnUrl') || '';
            var target = '@mainboardUrl' + (returnUrl ? '#' + returnUrl : '');
            window.top.location.href = '@loginUrl' + '?ReturnUrl=' + encodeURIComponent(target);
        })();
    </script>
}
<div class="main-wrapper">
    <div class="account-content">
        <div class="login-wrapper bg-img">
            <div class="login-content authent-content">
                <form asp-action="Login" asp-controller="Auth" method="post" id="login-form" novalidate>
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div class="login-userset">
                        <div class="login-logo logo-normal">
                            <img src="~/img/logo.svg" alt="@AppSettings.Value.Name">
                        </div>
                        <div class="login-logo logo-white">
                            <img src="~/img/logo-white.svg" alt="@AppSettings.Value.Name">
                        </div>
                        <div class="login-userheading">
                            <h3>Sign In</h3>
                            <h4 class="fs-16">Sign in to the @AppSettings.Value.Name admin office with your email and password.</h4>
                        </div>

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="Email" type="email" autocomplete="username" autofocus class="form-control border-end-0">
                                <span class="input-group-text border-start-0">
                                    <i class="ti ti-mail"></i>
                                </span>
                            </div>
                            <span asp-validation-for="Email" class="text-danger fs-13"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password <span class="text-danger">*</span></label>
                            <div class="pass-group">
                                <input asp-for="Password" autocomplete="current-password" class="pass-input form-control">
                                <span class="ti toggle-password ti-eye-off text-gray-9"></span>
                            </div>
                            <span asp-validation-for="Password" class="text-danger fs-13"></span>
                        </div>
                        <div class="form-login authentication-check">
                            <div class="custom-control custom-checkbox">
                                <label class="checkboxs ps-4 mb-0 pb-0 line-height-1 fs-16 text-gray-6">
                                    <input name="RememberMe" type="checkbox" value="true" class="form-control" @(Model.RememberMe == true ? "checked" : "")>
                                    <span class="checkmarks"></span>Remember me
                                </label>
                            </div>
                        </div>
                        <div class="form-login">
                            <button type="submit" class="btn btn-primary w-100">Sign In</button>
                        </div>

                        <div class="my-4 d-flex justify-content-center align-items-center copyright-text">
                            <p>Copyright &copy; @DateTime.Now.Year @AppSettings.Value.CompanyName</p>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        // /Main#/some/page opened while signed out: the browser keeps the hash on the redirect to this page;
        // carry it into the return URL so the user lands on that page after signing in.
        (function () {
            var field = document.getElementById('ReturnUrl');
            if (!window.location.hash || !field || field.value.indexOf('#') >= 0) { return; }
            field.value = (field.value || '@mainboardUrl') + window.location.hash;
        })();
    </script>
}
