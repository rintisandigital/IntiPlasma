@model ListViewModel<Application.Contracts.ContractResponse>
@{
    ViewData["Title"] = "Contracts";
    ViewData["Menu"] = MenuCodes.PartnershipContracts;
}
<partial name="Partials/_ListHeader" model='new ListHeaderModel("Partnership Contracts", "Price contract or profit sharing terms used by new cycles", MenuCodes.PartnershipContracts, "Add Contract")' />

<div class="card">
    <div class="card-header">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search code or name">
            </div>
            <div class="col-md-3">
                <select name="branch" class="form-select" asp-items="Model.BranchOptions" aria-label="Branch"></select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select" asp-items='Model.FilterOptions["status"]'>
                    <option value="">All statuses</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="ti ti-filter me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-light">Reset</a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr><th>Code</th><th>Name</th><th>Branch</th><th>Scheme</th><th>Valid</th><th class="text-end">Plasma share</th><th>PPh</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (Application.Contracts.ContractResponse contract in Model.Rows.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@contract.Code</td>
                            <td>@contract.Name</td>
                            <td>@contract.BranchCode</td>
                            <td>@EnumOptions.Label(contract.Scheme)</td>
                            <td class="text-nowrap">@Fmt.Date(contract.ValidFrom) – @(contract.ValidTo is { } to ? Fmt.Date(to) : "open")</td>
                            <td class="text-end">@(contract.PlasmaProfitSharePercent is { } share ? $"{Fmt.Number(share, 2)}%" : "—")</td>
                            <td>@(contract.IncomeTaxCode ?? "—")</td>
                            <td><partial name="Partials/_StatusBadge" model="contract.Status" /></td>
                            <td class="text-end"><a asp-action="Details" asp-route-id="@contract.Id" class="btn btn-sm btn-light" title="Open"><i class="ti ti-eye"></i></a></td>
                        </tr>
                    }
                    @if (Model.Rows.Items.Count == 0)
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">No contracts found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="Partials/_Pagination" model="PaginationModel.From(Model.Rows)" />
    </div>
</div>
