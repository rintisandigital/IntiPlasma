@model ContractDetailsViewModel
@{
    Application.Contracts.ContractResponse contract = Model.Contract;
    ViewData["Title"] = $"Contract {contract.Code}";
    ViewData["Menu"] = MenuCodes.PartnershipContracts;
    bool isDraft = contract.Status == "Draft";
    bool isActive = contract.Status == "Active";
}
<div class="page-header">
    <div class="add-item d-flex">
        <div class="page-title">
            <h4 class="fw-bold">Contract @contract.Code <partial name="Partials/_StatusBadge" model="contract.Status" /></h4>
            <h6>@contract.Name</h6>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-light"><i class="ti ti-arrow-left me-1"></i>Back</a>
        <a asp-action="Print" asp-route-id="@contract.Id" asp-menu="@MenuCodes.PartnershipContracts" asp-right="Export" target="_blank" class="btn btn-outline-danger">
            <i class="ti ti-file-type-pdf me-1"></i>Print PDF
        </a>
        @if (Model.CanEditDraft)
        {
            <a asp-action="Edit" asp-route-id="@contract.Id" class="btn btn-outline-primary"><i class="ti ti-edit me-1"></i>Edit</a>
        }
        @if (Model.CanChangeStatus && (isDraft || contract.Status == "Inactive"))
        {
            <form asp-action="Activate" asp-route-id="@contract.Id" method="post" data-confirm="Activate contract @contract.Code? New cycles can then use it.">
                <button type="submit" class="btn btn-success"><i class="ti ti-check me-1"></i>Activate</button>
            </form>
        }
        @if (Model.CanChangeStatus && isActive)
        {
            <form asp-action="Deactivate" asp-route-id="@contract.Id" method="post" data-confirm="Deactivate contract @contract.Code? Running cycles keep their snapshot.">
                <button type="submit" class="btn btn-outline-danger"><i class="ti ti-ban me-1"></i>Deactivate</button>
            </form>
        }
    </div>
</div>

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">Terms</h5></div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-3 mb-3"><div class="text-muted fs-13">Branch</div><div class="fw-semibold">@contract.BranchCode</div></div>
            <div class="col-md-3 mb-3"><div class="text-muted fs-13">Scheme</div><div class="fw-semibold">@EnumOptions.Label(contract.Scheme)</div></div>
            <div class="col-md-3 mb-3">
                <div class="text-muted fs-13">Valid</div>
                <div class="fw-semibold">@Fmt.Date(contract.ValidFrom) – @(contract.ValidTo is { } to ? Fmt.Date(to) : "open-ended")</div>
            </div>
            <div class="col-md-3 mb-3"><div class="text-muted fs-13">Income tax (PPh)</div><div class="fw-semibold">@(contract.IncomeTaxCode ?? "—")</div></div>
            @if (contract.PlasmaProfitSharePercent is { } share)
            {
                <div class="col-md-3 mb-3"><div class="text-muted fs-13">Plasma profit share</div><div class="fw-semibold">@Fmt.Number(share, 2)%</div></div>
            }
            @if (!string.IsNullOrWhiteSpace(contract.Notes))
            {
                <div class="col-12"><div class="text-muted fs-13">Notes</div><div style="white-space: pre-line">@contract.Notes</div></div>
            }
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0">Sapronak contract prices</h5></div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead class="thead-light"><tr><th>Item</th><th>Unit</th><th class="text-end">Price</th></tr></thead>
                    <tbody>
                        @foreach (Application.Contracts.ContractResponse.InputPriceResponse price in contract.InputPrices ?? [])
                        {
                            <tr><td>@price.ItemCode — @price.ItemName</td><td>@price.UomCode</td><td class="text-end">@Fmt.Money(price.Price)</td></tr>
                        }
                        @if ((contract.InputPrices ?? []).Count == 0)
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">None.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0">Guaranteed live bird prices</h5></div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead class="thead-light"><tr><th class="text-end">From (kg)</th><th class="text-end">To (kg)</th><th class="text-end">Price / kg</th></tr></thead>
                    <tbody>
                        @foreach (Application.Contracts.ContractResponse.LiveBirdPriceResponse price in contract.LiveBirdPrices ?? [])
                        {
                            <tr>
                                <td class="text-end">@Fmt.Number(price.MinWeightKg, 3)</td>
                                <td class="text-end">@Fmt.Number(price.MaxWeightKg, 3)</td>
                                <td class="text-end">@Fmt.Money(price.PricePerKg)</td>
                            </tr>
                        }
                        @if ((contract.LiveBirdPrices ?? []).Count == 0)
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">None.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">Bonuses and deductions</h5></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead class="thead-light"><tr><th>Name</th><th>Kind</th><th>Metric</th><th>Range</th><th class="text-end">Amount</th><th>Basis</th></tr></thead>
                <tbody>
                    @foreach (Application.Contracts.ContractResponse.IncentiveResponse incentive in contract.Incentives ?? [])
                    {
                        <tr>
                            <td>@incentive.Name</td>
                            <td><span class="badge @(incentive.Kind == "Bonus" ? "bg-success" : "bg-danger")">@incentive.Kind</span></td>
                            <td>@EnumOptions.Label(incentive.Metric)</td>
                            <td>@(incentive.RangeFrom is { } from ? Fmt.Number(from, 3) : "…") – @(incentive.RangeTo is { } rangeTo ? Fmt.Number(rangeTo, 3) : "…")</td>
                            <td class="text-end">@Fmt.Money(incentive.Amount)</td>
                            <td>@EnumOptions.Label(incentive.Basis)</td>
                        </tr>
                    }
                    @if ((contract.Incentives ?? []).Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-3">None.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">Attachments</h5></div>
    <div class="card-body">
        @if (Model.CanManageAttachments)
        {
            <form asp-action="Documents" asp-route-id="@contract.Id" method="post">
                <partial name="Partials/_Attachments" model='new AttachmentsModel(Model.Attachments, true, "documents")' />
                <button type="submit" class="btn btn-sm btn-primary mt-2"><i class="ti ti-device-floppy me-1"></i>Save attachments</button>
            </form>
        }
        else
        {
            <partial name="Partials/_Attachments" model="new AttachmentsModel(Model.Attachments, false)" />
        }
    </div>
</div>
