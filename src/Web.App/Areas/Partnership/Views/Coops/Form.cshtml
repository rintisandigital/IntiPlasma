@model CoopFormViewModel
@{
    ViewData["Title"] = Model.IsNew ? "Add Coop" : $"Coop {Model.Code}";
    ViewData["Menu"] = MenuCodes.PartnershipCoops;
}
<partial name="Partials/_PageHeader" model='new PageHeaderModel(Model.IsNew ? "Add Coop" : $"Coop {Model.Code}", "The coop warehouse GK-{code} is created automatically")' />

<form asp-action="@(Model.IsNew ? "Create" : "Edit")" method="post">
    @if (Model.IsNew)
    {
        <form-token />
    }
    else
    {
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Code" />
        <input type="hidden" asp-for="FarmerId" />
    }
    <fieldset disabled="@(!Model.CanSave)">
        <div class="card">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FarmerId" class="form-label"></label> <span class="text-danger">*</span>
                        @if (Model.IsNew)
                        {
                            <select asp-for="FarmerId" class="form-select" data-lookup="@Url.Action("Farmers", "Lookup", new { area = "" })">
                                <option value="">Search farmer…</option>
                                @if (Model.FarmerId is not null && Model.FarmerLabel is not null)
                                {
                                    <option value="@Model.FarmerId" selected>@Model.FarmerLabel</option>
                                }
                            </select>
                            <span asp-validation-for="FarmerId" class="text-danger fs-13"></span>
                        }
                        else
                        {
                            <input class="form-control" value="@Model.FarmerLabel" disabled>
                            <div class="form-text">Branch @Model.BranchCode@(Model.OpenCycleId is null ? "" : " · a cycle is running in this coop")</div>
                        }
                    </div>
                    <div class="col-md-2 mb-3">
                        <label asp-for="Code" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="Code" class="form-control text-uppercase" disabled="@(!Model.IsNew)">
                        <span asp-validation-for="Code" class="text-danger fs-13"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Name" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="Name" class="form-control">
                        <span asp-validation-for="Name" class="text-danger fs-13"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="Capacity" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="Capacity" type="number" min="1" step="1" class="form-control">
                        <span asp-validation-for="Capacity" class="text-danger fs-13"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="HouseType" class="form-label"></label> <span class="text-danger">*</span>
                        <select asp-for="HouseType" class="form-select" asp-items="EnumOptions.For(Model.HouseType)"></select>
                        <span asp-validation-for="HouseType" class="text-danger fs-13"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="Latitude" class="form-label"></label>
                        <input asp-for="Latitude" type="number" step="0.000001" min="-90" max="90" class="form-control">
                        <span asp-validation-for="Latitude" class="text-danger fs-13"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="Longitude" class="form-label"></label>
                        <input asp-for="Longitude" type="number" step="0.000001" min="-180" max="180" class="form-control">
                        <span asp-validation-for="Longitude" class="text-danger fs-13"></span>
                    </div>
                    <div class="col-12 mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address" class="form-control">
                    </div>
                    @if (!Model.IsNew)
                    {
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="IsActive" name="IsActive" value="true" checked="@(Model.IsActive == true)">
                                <label class="form-check-label" for="IsActive">Active</label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </fieldset>

    <div class="card">
        <div class="card-header"><h5 class="card-title mb-0">Attachments</h5></div>
        <div class="card-body"><partial name="Partials/_Attachments" model="new AttachmentsModel(Model.Attachments, Model.CanSave)" /></div>
    </div>

    <partial name="Partials/_FormButtons" model='new FormButtonsModel(Model.CanSave, Url.Action("Index")!)' />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
