@model ListViewModel<Application.Farmers.FarmerResponse>
@{
    ViewData["Title"] = "Farmers";
    ViewData["Menu"] = MenuCodes.PartnershipFarmers;
    bool canExport = await Rights.CanAsync(MenuCodes.PartnershipFarmers, MenuRights.Export);
}
<partial name="Partials/_ListHeader" model='new ListHeaderModel("Farmers", "Inti and plasma farmers per branch", MenuCodes.PartnershipFarmers, "Add Farmer")' />

<div class="card">
    <div class="card-header">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search code, name or NIK">
            </div>
            <div class="col-md-3">
                <select name="branch" class="form-select" asp-items="Model.BranchOptions" aria-label="Branch"></select>
            </div>
            <div class="col-md-2">
                <select name="type" class="form-select" asp-items='Model.FilterOptions["type"]'>
                    <option value="">All types</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="ti ti-filter me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-light">Reset</a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr><th>Code</th><th>Name</th><th>Type</th><th>Branch</th><th>Phone</th><th class="text-end">Farms</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (Application.Farmers.FarmerResponse farmer in Model.Rows.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@farmer.Code</td>
                            <td>@farmer.Name</td>
                            <td>@farmer.Type</td>
                            <td>@farmer.BranchCode</td>
                            <td>@(farmer.Phone ?? "—")</td>
                            <td class="text-end">
                                <a asp-controller="Coops" asp-action="Index" asp-route-farmerId="@farmer.Id" asp-route-branch="all">@Fmt.Number(farmer.CoopCount)</a>
                            </td>
                            <td><partial name="Partials/_StatusBadge" model='farmer.IsActive ? "Active" : "Inactive"' /></td>
                            <td class="text-end text-nowrap">
                                @if (canExport)
                                {
                                    <a asp-action="Print" asp-route-id="@farmer.Id" target="_blank" class="btn btn-sm btn-light" title="PDF"><i class="ti ti-file-type-pdf"></i></a>
                                }
                                <a asp-action="Edit" asp-route-id="@farmer.Id" class="btn btn-sm btn-light" title="Open"><i class="ti ti-eye"></i></a>
                            </td>
                        </tr>
                    }
                    @if (Model.Rows.Items.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No farmers found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="Partials/_Pagination" model="PaginationModel.From(Model.Rows)" />
    </div>
</div>
