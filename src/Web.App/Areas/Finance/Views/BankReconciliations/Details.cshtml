@model BankReconciliationDetailsViewModel
@using System.Globalization
@{
    Application.Finance.CashBank.BankReconciliationResponse rec = Model.Reconciliation;
    ViewData["Title"] = $"Reconciliation {rec.CashBankCode}";
    ViewData["Menu"] = MenuCodes.FinanceBankReconciliations;
    bool editable = Model.CanEdit && Model.IsOpen;
    bool canExport = await Rights.CanAsync(MenuCodes.FinanceBankReconciliations, MenuRights.Export);
    string Iso(DateOnly date) => date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
}
<div class="page-header">
    <div class="add-item d-flex">
        <div class="page-title">
            <h4 class="fw-bold">Reconciliation @rec.CashBankCode <partial name="Partials/_StatusBadge" model="rec.Status" /></h4>
            <h6>@rec.CashBankName · statement of @Fmt.Date(rec.StatementDate)</h6>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-light"><i class="ti ti-arrow-left me-1"></i>Back</a>
        @if (canExport)
        {
            <a asp-action="StatementExport" asp-route-id="@rec.Id" asp-route-format="xlsx" target="_blank" class="btn btn-outline-success">Excel</a>
            <a asp-action="StatementExport" asp-route-id="@rec.Id" asp-route-format="pdf" target="_blank" class="btn btn-outline-danger">PDF</a>
        }
        @if (editable)
        {
            <form asp-action="AutoMatch" asp-route-id="@rec.Id" method="post">
                <button type="submit" class="btn btn-outline-primary"><i class="ti ti-wand me-1"></i>Auto-match</button>
            </form>
            <form asp-action="Complete" asp-route-id="@rec.Id" method="post" data-confirm="Complete this reconciliation? The matched ledger lines become cleared.">
                <button type="submit" class="btn btn-success" disabled="@(!Model.CanComplete)" title="@(Model.CanComplete ? "" : "Every statement line must be matched and the difference must be zero")"><i class="ti ti-check me-1"></i>Complete</button>
            </form>
        }
    </div>
</div>

<div class="row">
    <div class="col-md col-6">
        <div class="card"><div class="card-body">
            <div class="text-muted fs-13">Statement balance</div>
            <div class="fw-bold fs-5">@Fmt.Money(rec.StatementBalance)</div>
            @if (editable)
            {
                <form asp-action="StatementBalance" asp-route-id="@rec.Id" method="post" class="input-group input-group-sm mt-2">
                    <input type="number" name="statementBalance" step="0.01" value="@rec.StatementBalance.ToString(CultureInfo.InvariantCulture)" class="form-control text-end" aria-label="Statement balance" required>
                    <button type="submit" class="btn btn-light" title="Update the statement balance"><i class="ti ti-device-floppy"></i></button>
                </form>
            }
        </div></div>
    </div>
    <div class="col-md col-6"><div class="card"><div class="card-body"><div class="text-muted fs-13">Book balance</div><div class="fw-bold fs-5">@Fmt.Money(rec.BookBalance)</div></div></div></div>
    <div class="col-md col-6"><div class="card"><div class="card-body"><div class="text-muted fs-13">Uncleared (not on statement)</div><div class="fw-bold fs-5">@Fmt.Money(rec.UnclearedNet)</div></div></div></div>
    <div class="col-md col-6">
        <div class="card @(rec.Difference == 0 ? "border-success" : "border-danger")"><div class="card-body">
            <div class="text-muted fs-13">Difference</div>
            <div class="fw-bold fs-5 @(rec.Difference == 0 ? "text-success" : "text-danger")" id="reconciliation-difference">@Fmt.Money(rec.Difference)</div>
            <div class="fs-12 text-muted">statement − (book − uncleared)</div>
        </div></div>
    </div>
    <div class="col-md col-6"><div class="card"><div class="card-body"><div class="text-muted fs-13">Unmatched statement lines</div><div class="fw-bold fs-5 @(rec.UnmatchedStatementLines > 0 ? "text-warning" : "")">@rec.UnmatchedStatementLines</div></div></div></div>
</div>

@if (editable)
{
    <div class="row">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header"><h6 class="mb-0">Import statement (CSV)</h6></div>
                <div class="card-body">
                    <form asp-action="Import" asp-route-id="@rec.Id" method="post" enctype="multipart/form-data">
                        <input type="file" name="file" accept=".csv,text/csv,text/plain" class="form-control form-control-sm mb-2" aria-label="CSV file">
                        <textarea name="csv" rows="3" class="form-control form-control-sm font-monospace mb-2" placeholder="…or paste: date,description,debit,credit"></textarea>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="form-text m-0">Columns <code>date,description,debit,credit</code> (bank's view: debit = money out); date yyyy-MM-dd or dd/MM/yyyy; header optional.</span>
                            <button type="submit" class="btn btn-sm btn-primary ms-2"><i class="ti ti-upload me-1"></i>Import</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header"><h6 class="mb-0">Add a statement line</h6></div>
                <div class="card-body">
                    <form asp-action="AddLine" asp-route-id="@rec.Id" method="post" class="row g-2">
                        <div class="col-md-4"><input type="date" name="date" value="@Iso(rec.StatementDate)" class="form-control form-control-sm" aria-label="Date" required></div>
                        <div class="col-md-8"><input name="description" maxlength="250" class="form-control form-control-sm" placeholder="Description" required></div>
                        <div class="col-md-4"><input type="number" name="moneyIn" min="0" step="0.01" class="form-control form-control-sm text-end" placeholder="Money in"></div>
                        <div class="col-md-4"><input type="number" name="moneyOut" min="0" step="0.01" class="form-control form-control-sm text-end" placeholder="Money out"></div>
                        <div class="col-md-4"><button type="submit" class="btn btn-sm btn-outline-primary w-100"><i class="ti ti-plus me-1"></i>Add line</button></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<div class="row">
    <div class="col-xl-7">
        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0">Bank statement</h5></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0" id="statement-lines">
                        <thead class="thead-light"><tr><th>#</th><th>Date</th><th>Description</th><th class="text-end">Amount</th><th style="width: 40%">Ledger line</th></tr></thead>
                        <tbody>
                            @foreach (Application.Finance.CashBank.StatementLineResponse line in rec.StatementLines)
                            {
                                bool matched = line.MatchedJournalEntryId is not null;
                                <tr class="@(matched ? "table-success" : "")">
                                    <td>@line.LineNumber</td>
                                    <td class="text-nowrap">@Fmt.Date(line.Date)</td>
                                    <td>@line.Description</td>
                                    <td class="text-end text-nowrap @(line.Amount < 0 ? "text-danger" : "")">@Fmt.Number(line.Amount)</td>
                                    <td>
                                        @if (matched)
                                        {
                                            <div class="d-flex align-items-center justify-content-between gap-2">
                                                <span><i class="ti ti-link me-1"></i>@line.MatchedJournalNumber</span>
                                                @if (editable)
                                                {
                                                    <form asp-action="Unmatch" asp-route-id="@rec.Id" method="post">
                                                        <input type="hidden" name="lineNumber" value="@line.LineNumber">
                                                        <button type="submit" class="btn btn-sm btn-light" title="Remove the match"><i class="ti ti-unlink"></i></button>
                                                    </form>
                                                }
                                            </div>
                                        }
                                        else if (editable)
                                        {
                                            <div class="d-flex gap-1">
                                                <form asp-action="Match" asp-route-id="@rec.Id" method="post" class="input-group input-group-sm flex-nowrap">
                                                    <input type="hidden" name="lineNumber" value="@line.LineNumber">
                                                    <select name="entry" class="form-select form-select-sm" aria-label="Ledger line" required>
                                                        <option value="">Choose ledger line…</option>
                                                        @foreach (Application.Finance.CashBank.UnclearedEntryResponse entry in Model.Candidates(line))
                                                        {
                                                            <option value="@entry.JournalEntryId:@entry.JournalLineNumber.ToString(CultureInfo.InvariantCulture)">@(entry.Amount == line.Amount ? "✓ " : "")@entry.Number · @Fmt.Date(entry.Date) · @Fmt.Number(entry.Amount)</option>
                                                        }
                                                    </select>
                                                    <button type="submit" class="btn btn-primary" title="Match"><i class="ti ti-link"></i></button>
                                                </form>
                                                <form asp-action="RemoveLine" asp-route-id="@rec.Id" method="post" data-confirm="Remove statement line @line.LineNumber?">
                                                    <input type="hidden" name="lineNumber" value="@line.LineNumber">
                                                    <button type="submit" class="btn btn-sm btn-light" title="Remove line"><i class="ti ti-trash"></i></button>
                                                </form>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Unmatched</span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (rec.StatementLines.Count == 0)
                            {
                                <tr><td colspan="5" class="text-center text-muted py-3">No statement line yet — import a CSV or add lines.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-5">
        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0">Uncleared ledger lines (up to @Fmt.Date(rec.StatementDate))</h5></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0" id="uncleared-entries">
                        <thead class="thead-light"><tr><th>Date</th><th>Journal</th><th>Description</th><th class="text-end">Amount</th></tr></thead>
                        <tbody>
                            @foreach (Application.Finance.CashBank.UnclearedEntryResponse entry in rec.UnclearedEntries)
                            {
                                <tr>
                                    <td class="text-nowrap">@Fmt.Date(entry.Date)</td>
                                    <td class="text-nowrap">@entry.Number</td>
                                    <td>@entry.Description</td>
                                    <td class="text-end text-nowrap @(entry.Amount < 0 ? "text-danger" : "")">@Fmt.Number(entry.Amount)</td>
                                </tr>
                            }
                            @if (rec.UnclearedEntries.Count == 0)
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">Every ledger line is matched or cleared.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
