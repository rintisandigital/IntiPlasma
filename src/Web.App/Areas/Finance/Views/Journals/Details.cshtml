@model JournalDetailsViewModel
@{
    Application.Finance.Journals.JournalResponse journal = Model.Journal;
    string title = journal.Number ?? "Journal draft";
    ViewData["Title"] = title;
    ViewData["Menu"] = MenuCodes.FinanceJournals;
    string by(string? name, DateTime? at)
    {
        if (at is not { } time)
        {
            return "—";
        }

        return name is null ? Fmt.DateTime(time) : $"{Fmt.DateTime(time)} by {name}";
    }
}
<div class="page-header">
    <div class="add-item d-flex">
        <div class="page-title">
            <h4 class="fw-bold">@title <partial name="Partials/_StatusBadge" model="journal.Status" /></h4>
            <h6>@JournalSources.Label(journal.SourceType) · @journal.BranchCode · @Fmt.Date(journal.Date)</h6>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-light"><i class="ti ti-arrow-left me-1"></i>Back</a>
        @if (Model.SourceUrl is not null)
        {
            <a href="@Model.SourceUrl" class="btn btn-outline-primary"><i class="ti ti-file-text me-1"></i>Open source document</a>
        }
        @if (Model.CanPrint)
        {
            <a asp-action="Print" asp-route-id="@journal.Id" target="_blank" class="btn btn-outline-danger"><i class="ti ti-file-type-pdf me-1"></i>Journal Voucher PDF</a>
        }
        @if (Model.IsManual && Model.IsDraft && Model.CanEdit)
        {
            <a asp-action="Edit" asp-route-id="@journal.Id" class="btn btn-outline-primary"><i class="ti ti-edit me-1"></i>Edit</a>
            <form asp-action="Approve" asp-route-id="@journal.Id" method="post" data-confirm="Approve this journal? The maker cannot approve their own journal.">
                <button type="submit" class="btn btn-success"><i class="ti ti-check me-1"></i>Approve</button>
            </form>
        }
        @if (Model.IsManual && Model.IsDraft && Model.CanDelete)
        {
            <form asp-action="Delete" asp-route-id="@journal.Id" method="post" data-confirm="Delete this journal draft?">
                <button type="submit" class="btn btn-outline-danger"><i class="ti ti-trash me-1"></i>Delete</button>
            </form>
        }
        @if (Model.IsApproved && Model.CanEdit)
        {
            <form asp-action="Post" asp-route-id="@journal.Id" method="post" data-confirm="Post this journal to the ledger? It gets a number and can only be corrected by a reversal.">
                <button type="submit" class="btn btn-primary"><i class="ti ti-send me-1"></i>Post</button>
            </form>
        }
        @if (Model.IsManual && Model.IsPosted && Model.CanEdit)
        {
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#reverse-modal"><i class="ti ti-arrow-back-up me-1"></i>Reverse</button>
        }
    </div>
</div>

@if (Model.IsManual && Model.IsDraft)
{
    <div class="alert alert-info">Draft — waiting for approval by another user (maker-checker), then it can be posted.</div>
}
@if (journal.ReversedById is Guid reversedBy)
{
    <div class="alert alert-warning">Reversed by <a asp-action="Details" asp-route-id="@reversedBy">@(Model.ReversalNumber ?? "the reversal journal")</a>.</div>
}
@if (journal.ReversalOfId is Guid original)
{
    <div class="alert alert-light border">This journal reverses <a asp-action="Details" asp-route-id="@original">the original journal</a>.</div>
}

<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6 mb-2"><div class="text-muted fs-13">Description</div><div class="fw-semibold">@journal.Description</div></div>
            <div class="col-md-2 mb-2"><div class="text-muted fs-13">Prepared by</div><div class="fw-semibold">@(journal.CreatedByName ?? (Model.IsManual ? "—" : "System"))</div></div>
            <div class="col-md-2 mb-2"><div class="text-muted fs-13">Approved</div><div class="fw-semibold">@by(journal.ApprovedByName, journal.ApprovedAtUtc)</div></div>
            <div class="col-md-2 mb-2"><div class="text-muted fs-13">Posted</div><div class="fw-semibold">@by(journal.PostedByName, journal.PostedAtUtc)</div></div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">Lines</h5></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead class="thead-light"><tr><th>#</th><th>Account</th><th>Cost center</th><th>Description</th><th class="text-end">Debit</th><th class="text-end">Credit</th></tr></thead>
                <tbody>
                    @foreach (Application.Finance.Journals.JournalLineResponse line in journal.Lines ?? [])
                    {
                        <tr>
                            <td>@line.LineNumber</td>
                            <td>@line.AccountCode — @line.AccountName</td>
                            <td>@(line.CostCenterCode ?? "")</td>
                            <td>@(line.Description ?? "")</td>
                            <td class="text-end text-nowrap">@(line.Debit == 0 ? "" : Fmt.Money(line.Debit))</td>
                            <td class="text-end text-nowrap">@(line.Credit == 0 ? "" : Fmt.Money(line.Credit))</td>
                        </tr>
                    }
                </tbody>
                <tfoot><tr><th colspan="4" class="text-end">Total</th><th class="text-end text-nowrap">@Fmt.Money(journal.TotalDebit)</th><th class="text-end text-nowrap">@Fmt.Money(journal.TotalCredit)</th></tr></tfoot>
            </table>
        </div>
    </div>
</div>

@if (Model.IsManual)
{
    <partial name="Partials/_AttachmentsCard" model='new AttachmentsCardModel(Model.Attachments, Model.CanEdit ? Url.Action("Documents", new { id = journal.Id }) : null)' />
    <partial name="Partials/_ReasonModal" model='new ReasonModalModel("reverse-modal", $"Reverse journal {journal.Number}", Url.Action("Reverse", new { id = journal.Id })!, "Reverse Journal", WithDate: true)' />
}
