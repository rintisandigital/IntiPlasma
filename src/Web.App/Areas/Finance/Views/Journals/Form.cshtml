@model JournalFormViewModel
@using System.Globalization
@{
    string title = Model.IsNew ? "New Journal" : "Edit Journal Draft";
    ViewData["Title"] = title;
    ViewData["Menu"] = MenuCodes.FinanceJournals;
    string accountLookup = Url.Action("Accounts", "Lookup", new { area = "" })!;
    string Inv(decimal? value) => value?.ToString("0.##", CultureInfo.InvariantCulture) ?? "";
}
<partial name="Partials/_PageHeader" model='new PageHeaderModel(title, "Debits must equal credits; another user approves the draft before it is posted")' />

@if (Model.IsNew && Model.Templates.Count > 0)
{
    <div class="card">
        <div class="card-body">
            <form method="get" asp-action="Create" class="row g-2 align-items-end">
                <input type="hidden" name="branchId" value="@Model.BranchId" />
                <div class="col-md-6">
                    <label class="form-label" for="template-select">Start from a template</label>
                    <select id="template-select" name="templateId" class="form-select" asp-items="Model.Templates" data-autosubmit>
                        <option value="">— none —</option>
                    </select>
                </div>
            </form>
        </div>
    </div>
}

<form asp-action="@(Model.IsNew ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" id="journal-form">
    @if (Model.IsNew)
    {
        <form-token />
    }
    <div class="card">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="BranchId" class="form-label"></label> <span class="text-danger">*</span>
                    @if (Model.IsNew)
                    {
                        <select asp-for="BranchId" class="form-select" asp-items="Model.Branches"></select>
                    }
                    else
                    {
                        <input type="hidden" asp-for="BranchId" />
                        <input class="form-control" value="@(Model.Branches.FirstOrDefault(b => b.Value == Model.BranchId?.ToString())?.Text)" disabled>
                    }
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Date" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="Date" type="date" class="form-control">
                    <span asp-validation-for="Date" class="text-danger fs-13"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Description" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="Description" class="form-control">
                    <span asp-validation-for="Description" class="text-danger fs-13"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h5 class="card-title mb-0">Lines</h5>
            <button type="button" class="btn btn-sm btn-outline-primary" data-collection-add="Lines"><i class="ti ti-plus me-1"></i>Add line</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0" data-collection="Lines">
                    <thead class="thead-light">
                        <tr><th style="width: 32%">Account</th><th>Cost center</th><th>Line description</th><th style="width: 14%">Debit</th><th style="width: 14%">Credit</th><th></th></tr>
                    </thead>
                    <tbody>
                        <tr class="collection-empty"><td colspan="6" class="text-center text-muted py-3">No line yet.</td></tr>
                        @for (int i = 0; i < Model.Lines.Count; i++)
                        {
                            JournalFormLineInput line = Model.Lines[i];
                            <tr class="collection-row">
                                <td>
                                    <input type="hidden" name="Lines[@i].AccountLabel" value="@line.AccountLabel" class="account-label">
                                    <select name="Lines[@i].AccountId" class="form-select account-select" data-lookup="@accountLookup">
                                        @if (line.AccountId is not null)
                                        {
                                            <option value="@line.AccountId" selected>@(line.AccountLabel ?? line.AccountId.ToString())</option>
                                        }
                                        else
                                        {
                                            <option value="">Search account…</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select name="Lines[@i].CostCenterId" class="form-select">
                                        <option value="">—</option>
                                        @foreach (SelectListItem costCenter in Model.CostCenters)
                                        {
                                            <option value="@costCenter.Value" selected="@(costCenter.Value == line.CostCenterId?.ToString())">@costCenter.Text</option>
                                        }
                                    </select>
                                </td>
                                <td><input name="Lines[@i].Description" value="@line.Description" maxlength="250" class="form-control"></td>
                                <td><input type="number" name="Lines[@i].Debit" value="@Inv(line.Debit)" min="0" step="0.01" class="form-control text-end line-debit"></td>
                                <td><input type="number" name="Lines[@i].Credit" value="@Inv(line.Credit)" min="0" step="0.01" class="form-control text-end line-credit"></td>
                                <td class="text-end"><button type="button" class="btn btn-sm btn-light collection-remove" title="Remove"><i class="ti ti-trash"></i></button></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr><th colspan="3" class="text-end">Total</th><th class="text-end text-nowrap" id="journal-debit">—</th><th class="text-end text-nowrap" id="journal-credit">—</th><th></th></tr>
                        <tr><th colspan="3" class="text-end">Difference</th><th colspan="2" class="text-end text-nowrap" id="journal-difference">—</th><th></th></tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5 class="card-title mb-0">Attachments (supporting documents)</h5></div>
        <div class="card-body"><partial name="Partials/_Attachments" model="new AttachmentsModel(Model.Attachments, true)" /></div>
    </div>

    <partial name="Partials/_FormButtons" model='new FormButtonsModel(true, Model.IsNew ? Url.Action("Index")! : Url.Action("Details", new { id = Model.Id })!, "Save Draft")' />
</form>

<template data-collection-template="Lines">
    <tr class="collection-row">
        <td>
            <input type="hidden" name="Lines[__i__].AccountLabel" class="account-label">
            <select name="Lines[__i__].AccountId" class="form-select account-select" data-lookup="@accountLookup">
                <option value="">Search account…</option>
            </select>
        </td>
        <td>
            <select name="Lines[__i__].CostCenterId" class="form-select">
                <option value="">—</option>
                @foreach (SelectListItem costCenter in Model.CostCenters)
                {
                    <option value="@costCenter.Value">@costCenter.Text</option>
                }
            </select>
        </td>
        <td><input name="Lines[__i__].Description" maxlength="250" class="form-control"></td>
        <td><input type="number" name="Lines[__i__].Debit" min="0" step="0.01" class="form-control text-end line-debit"></td>
        <td><input type="number" name="Lines[__i__].Credit" min="0" step="0.01" class="form-control text-end line-credit"></td>
        <td class="text-end"><button type="button" class="btn btn-sm btn-light collection-remove" title="Remove"><i class="ti ti-trash"></i></button></td>
    </tr>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var form = document.getElementById('journal-form');
            var money = new Intl.NumberFormat('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            function sum(selector) {
                var total = 0;
                form.querySelectorAll(selector).forEach(function (input) { total += parseFloat(input.value) || 0; });
                return Math.round(total * 100) / 100;
            }
            function recalc() {
                var debit = sum('.line-debit'), credit = sum('.line-credit'), difference = Math.round((debit - credit) * 100) / 100;
                document.getElementById('journal-debit').textContent = 'Rp ' + money.format(debit);
                document.getElementById('journal-credit').textContent = 'Rp ' + money.format(credit);
                var cell = document.getElementById('journal-difference');
                cell.textContent = difference === 0 ? 'Balanced' : 'Rp ' + money.format(difference);
                cell.classList.toggle('text-danger', difference !== 0);
                cell.classList.toggle('text-success', difference === 0 && debit > 0);
            }
            form.addEventListener('input', recalc);
            form.addEventListener('click', function () { setTimeout(recalc, 0); });
            // Keep the chosen account's label so a re-rendered form (validation error) still shows it.
            form.addEventListener('change', function (e) {
                if (e.target.classList.contains('account-select')) {
                    var option = e.target.options[e.target.selectedIndex];
                    e.target.closest('td').querySelector('.account-label').value = option ? option.text : '';
                }
            });
            recalc();
        })();
    </script>
}
