@model ListViewModel<Application.Finance.CostCenters.CostCenterResponse>
@{
    ViewData["Title"] = "Cost Centers";
    ViewData["Menu"] = MenuCodes.FinanceCostCenters;
}
<partial name="Partials/_ListHeader" model='new ListHeaderModel("Cost Centers", "Used on journal lines and auto journal mappings", MenuCodes.FinanceCostCenters, "Add Cost Center")' />

<div class="card">
    <div class="card-header">
        <partial name="Partials/_FilterBar" model='new FilterBarModel(Model.Search, "Search code or name")' />
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr><th>Code</th><th>Name</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (Application.Finance.CostCenters.CostCenterResponse costCenter in Model.Rows.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@costCenter.Code</td>
                            <td>@costCenter.Name</td>
                            <td><partial name="Partials/_StatusBadge" model='costCenter.IsActive ? "Active" : "Inactive"' /></td>
                            <td class="text-end"><a asp-action="Edit" asp-route-id="@costCenter.Id" class="btn btn-sm btn-light" title="Open"><i class="ti ti-eye"></i></a></td>
                        </tr>
                    }
                    @if (Model.Rows.Items.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">No cost centers found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
