@model ListViewModel<Application.Inventory.StockBalanceResponse>
@{
    ViewData["Title"] = "Stock Balance";
    ViewData["Menu"] = MenuCodes.InventoryStock;
    bool includeEmpty = Model.Filters.GetValueOrDefault("includeEmpty") == "true";
    DateOnly today = Fmt.Today();
}
<partial name="Partials/_ListHeader" model='new ListHeaderModel("Stock Balance", "Quantity on hand and moving average cost per warehouse", MenuCodes.InventoryStock)' />

<div class="card">
    <div class="card-header">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search item code or name">
            </div>
            <div class="col-md-2">
                <select name="branch" class="form-select" asp-items="Model.BranchOptions"></select>
            </div>
            <div class="col-md-3">
                <select name="warehouseId" class="form-select" asp-items='Model.FilterOptions["warehouse"]'>
                    <option value="">All warehouses</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="category" class="form-select" asp-items='Model.FilterOptions["category"]'>
                    <option value="">All categories</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2 align-items-center">
                <div class="form-check mb-0" title="Show items with zero stock">
                    <input class="form-check-input" type="checkbox" id="includeEmpty" name="includeEmpty" value="true" checked="@includeEmpty">
                    <label class="form-check-label fs-13" for="includeEmpty">Zero</label>
                </div>
                <button type="submit" class="btn btn-primary"><i class="ti ti-filter"></i></button>
                <a asp-action="Index" class="btn btn-light">Reset</a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr><th>Warehouse</th><th>Item</th><th>Category</th><th class="text-end">Quantity</th><th class="text-end">Average cost</th><th class="text-end">Value</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (Application.Inventory.StockBalanceResponse balance in Model.Rows.Items)
                    {
                        <tr>
                            <td>@balance.WarehouseCode <span class="text-muted fs-12">@balance.WarehouseType</span></td>
                            <td>@balance.ItemCode — @balance.ItemName</td>
                            <td>@EnumOptions.Label(balance.ItemCategory)</td>
                            <td class="text-end text-nowrap">@Fmt.Number(balance.Quantity, 3) @balance.BaseUomCode</td>
                            <td class="text-end text-nowrap">@Fmt.Money(balance.AverageCost)</td>
                            <td class="text-end text-nowrap">@Fmt.Money(balance.Value)</td>
                            <td class="text-end">
                                <a asp-action="Card" asp-route-warehouseId="@balance.WarehouseId" asp-route-itemId="@balance.ItemId"
                                   asp-route-from="@(new DateOnly(today.Year, today.Month, 1).ToString("yyyy-MM-dd"))" asp-route-to="@today.ToString("yyyy-MM-dd")"
                                   class="btn btn-sm btn-light" title="Stock card"><i class="ti ti-list-details"></i></a>
                            </td>
                        </tr>
                    }
                    @if (Model.Rows.Items.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No stock found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="Partials/_Pagination" model="PaginationModel.From(Model.Rows)" />
    </div>
</div>
