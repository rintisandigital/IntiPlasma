@* List of goods receipts / stock transfers / stock returns. ViewData: Title, Menu, Subtitle, AddText, ReferenceTitle,
   PartyTitle (optional). *@
@model ListViewModel<Application.Inventory.InventoryDocumentResponse>
@{
    string menu = (string)ViewData["Menu"]!;
    string? partyTitle = ViewData["PartyTitle"] as string;
}
<partial name="Partials/_ListHeader" model='new ListHeaderModel((string)ViewData["Title"]!, (string)ViewData["Subtitle"]!, menu, ViewData["AddText"] as string)' />

<div class="card">
    <div class="card-header">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search number">
            </div>
            <div class="col-md-3">
                <select name="branch" class="form-select" asp-items="Model.BranchOptions" aria-label="Branch"></select>
            </div>
            <div class="col-md-2">
                <input type="date" name="from" value="@Model.Filters.GetValueOrDefault("from")" class="form-control" title="From date">
            </div>
            <div class="col-md-2">
                <input type="date" name="to" value="@Model.Filters.GetValueOrDefault("to")" class="form-control" title="To date">
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="ti ti-filter"></i></button>
                <a asp-action="Index" class="btn btn-light">Reset</a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Number</th><th>Date</th><th>Branch</th><th>@ViewData["ReferenceTitle"]</th>
                        @if (partyTitle is not null)
                        {
                            <th>@partyTitle</th>
                        }
                        <th>Warehouse</th><th>Cycle</th><th class="text-end">Value</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Application.Inventory.InventoryDocumentResponse document in Model.Rows.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@document.Number</td>
                            <td>@Fmt.Date(document.Date)</td>
                            <td>@document.BranchCode</td>
                            <td>@document.Reference</td>
                            @if (partyTitle is not null)
                            {
                                <td>@(document.Party ?? "—")</td>
                            }
                            <td>@document.WarehouseCode</td>
                            <td>@(document.CycleNumber ?? "—")</td>
                            <td class="text-end text-nowrap">@Fmt.Money(document.TotalValue)</td>
                            <td class="text-end"><a asp-action="Details" asp-route-id="@document.Id" class="btn btn-sm btn-light" title="Open"><i class="ti ti-eye"></i></a></td>
                        </tr>
                    }
                    @if (Model.Rows.Items.Count == 0)
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">No documents found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="Partials/_Pagination" model="PaginationModel.From(Model.Rows)" />
    </div>
</div>
