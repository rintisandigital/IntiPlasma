@model ListViewModel<Application.Procurement.PurchaseOrderResponse>
@{
    ViewData["Title"] = "Purchase Orders";
    ViewData["Menu"] = MenuCodes.ProcurementPurchaseOrders;
    string? vendorId = Model.Filters.GetValueOrDefault("vendorId");
}
<partial name="Partials/_ListHeader" model='new ListHeaderModel("Purchase Orders", "Sapronak orders to vendors; goods are received against approved orders", MenuCodes.ProcurementPurchaseOrders, "New Purchase Order")' />

<div class="card">
    <div class="card-header">
        <form method="get" class="row g-2 align-items-end">
            @if (!string.IsNullOrEmpty(vendorId))
            {
                <input type="hidden" name="vendorId" value="@vendorId">
            }
            <div class="col-md-3">
                <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search PO number">
            </div>
            <div class="col-md-3">
                <select name="branch" class="form-select" asp-items="Model.BranchOptions"></select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select" asp-items='Model.FilterOptions["status"]'>
                    <option value="">All statuses</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="ti ti-filter me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-light">Reset</a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr><th>Number</th><th>Date</th><th>Branch</th><th>Vendor</th><th>Expected</th><th class="text-end">Subtotal</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (Application.Procurement.PurchaseOrderResponse order in Model.Rows.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@order.Number</td>
                            <td>@Fmt.Date(order.OrderDate)</td>
                            <td>@order.BranchCode</td>
                            <td>@order.VendorName</td>
                            <td>@(order.ExpectedDate is { } expected ? Fmt.Date(expected) : "—")</td>
                            <td class="text-end text-nowrap">@Fmt.Money(order.Subtotal)</td>
                            <td><partial name="Partials/_StatusBadge" model="order.Status" /></td>
                            <td class="text-end"><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-light" title="Open"><i class="ti ti-eye"></i></a></td>
                        </tr>
                    }
                    @if (Model.Rows.Items.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No purchase orders found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="Partials/_Pagination" model="PaginationModel.From(Model.Rows)" />
    </div>
</div>
