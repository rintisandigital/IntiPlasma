@model SalesOrderFormViewModel
@{
    ViewData["Title"] = Model.IsNew ? "New Sales Order" : $"Sales Order {Model.Number}";
    ViewData["Menu"] = MenuCodes.SalesOrders;
    string itemLookup = Url.Action("Items", "Lookup", new { area = "", category = "LiveBird" })!;
    string cancelUrl = Model.IsNew ? Url.Action("Index")! : Url.Action("Details", new { id = Model.Id })!;
}
<partial name="Partials/_PageHeader" model='new PageHeaderModel(Model.IsNew ? "New Sales Order" : $"Sales Order {Model.Number}", "Saved as a draft; approval checks the customer credit limit")' />

<form asp-action="@(Model.IsNew ? "Create" : "Edit")" method="post">
    @if (Model.IsNew)
    {
        <form-token />
    }
    else
    {
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Number" />
        <input type="hidden" asp-for="BranchId" />
        <input type="hidden" asp-for="CustomerId" />
        <input type="hidden" asp-for="CustomerLabel" />
    }
    <div class="card">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="BranchId" class="form-label"></label> <span class="text-danger">*</span>
                    <select asp-for="BranchId" class="form-select" asp-items="Model.Branches" disabled="@(!Model.IsNew)">
                        <option value="">—</option>
                    </select>
                    <span asp-validation-for="BranchId" class="text-danger fs-13"></span>
                </div>
                <div class="col-md-5 mb-3">
                    <label asp-for="CustomerId" class="form-label"></label> <span class="text-danger">*</span>
                    @if (Model.IsNew)
                    {
                        <input type="hidden" asp-for="CustomerLabel" id="customer-label" />
                        <select asp-for="CustomerId" class="form-select" data-lookup="@Url.Action("Customers", "Lookup", new { area = "" })"
                                data-copy-label="#customer-label">
                            <option value="">Search customer…</option>
                            @if (Model.CustomerId is not null)
                            {
                                <option value="@Model.CustomerId" selected>@Model.CustomerLabel</option>
                            }
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger fs-13"></span>
                    }
                    else
                    {
                        <input class="form-control" value="@Model.CustomerLabel" disabled>
                    }
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="OrderDate" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="OrderDate" type="date" class="form-control">
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="DeliveryDate" class="form-label"></label>
                    <input asp-for="DeliveryDate" type="date" class="form-control">
                </div>
                <div class="col-12 mb-3">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" rows="2" class="form-control"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h5 class="card-title mb-0">Lines</h5>
            <button type="button" class="btn btn-sm btn-outline-primary" data-collection-add="Lines"><i class="ti ti-plus me-1"></i>Add line</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0" data-collection="Lines" id="so-lines">
                    <thead class="thead-light"><tr><th style="width: 30%">Item (live bird)</th><th>Birds</th><th>Est. weight (kg)</th><th>Price/kg (Rp)</th><th>VAT</th><th class="text-end">Estimated</th><th></th></tr></thead>
                    <tbody>
                        <tr class="collection-empty"><td colspan="7" class="text-center text-muted py-3">No line yet.</td></tr>
                        @for (int i = 0; i < Model.Lines.Count; i++)
                        {
                            SalesOrderLineFormInput line = Model.Lines[i];
                            <tr class="collection-row">
                                <td>
                                    <select name="Lines[@i].ItemId" class="form-select" data-lookup="@itemLookup" required>
                                        @if (line.ItemId is not null)
                                        {
                                            <option value="@line.ItemId" selected>@(line.ItemLabel ?? line.ItemId.ToString())</option>
                                        }
                                        else
                                        {
                                            <option value="">Search item…</option>
                                        }
                                    </select>
                                </td>
                                <td><input type="number" name="Lines[@i].Birds" value="@line.Birds" min="1" step="1" class="form-control text-end" required></td>
                                <td><input type="number" name="Lines[@i].EstimatedWeightKg" value="@line.EstimatedWeightKg?.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)" min="0.001" step="0.001" class="form-control text-end line-weight" required></td>
                                <td><input type="number" name="Lines[@i].PricePerKg" value="@line.PricePerKg?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" min="0.01" step="0.01" class="form-control text-end line-price" required></td>
                                <td>
                                    <select name="Lines[@i].TaxCodeId" class="form-select">
                                        <option value="">No VAT</option>
                                        @foreach (SelectListItem vat in Model.VatCodes)
                                        {
                                            <option value="@vat.Value" selected="@(vat.Value == line.TaxCodeId?.ToString())">@vat.Text</option>
                                        }
                                    </select>
                                </td>
                                <td class="text-end text-nowrap line-amount">—</td>
                                <td class="text-end"><button type="button" class="btn btn-sm btn-light collection-remove" title="Remove"><i class="ti ti-trash"></i></button></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr><th colspan="5" class="text-end">Estimated total (excl. VAT)</th><th class="text-end text-nowrap" id="so-total">—</th><th></th></tr></tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5 class="card-title mb-0">Attachments</h5></div>
        <div class="card-body"><partial name="Partials/_Attachments" model="new AttachmentsModel(Model.Attachments, true)" /></div>
    </div>

    <partial name="Partials/_FormButtons" model='new FormButtonsModel(true, cancelUrl, "Save Draft")' />
</form>

<template data-collection-template="Lines">
    <tr class="collection-row">
        <td>
            <select name="Lines[__i__].ItemId" class="form-select" data-lookup="@itemLookup" required>
                <option value="">Search item…</option>
            </select>
        </td>
        <td><input type="number" name="Lines[__i__].Birds" min="1" step="1" class="form-control text-end" required></td>
        <td><input type="number" name="Lines[__i__].EstimatedWeightKg" min="0.001" step="0.001" class="form-control text-end line-weight" required></td>
        <td><input type="number" name="Lines[__i__].PricePerKg" min="0.01" step="0.01" class="form-control text-end line-price" required></td>
        <td>
            <select name="Lines[__i__].TaxCodeId" class="form-select">
                <option value="">No VAT</option>
                @foreach (SelectListItem vat in Model.VatCodes)
                {
                    <option value="@vat.Value">@vat.Text</option>
                }
            </select>
        </td>
        <td class="text-end text-nowrap line-amount">—</td>
        <td class="text-end"><button type="button" class="btn btn-sm btn-light collection-remove" title="Remove"><i class="ti ti-trash"></i></button></td>
    </tr>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            // Estimated amount = estimated weight × price per kg (display only).
            var table = document.getElementById('so-lines');
            var money = new Intl.NumberFormat('id-ID', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            function recalc() {
                var total = 0;
                table.querySelectorAll('tr.collection-row').forEach(function (row) {
                    var amount = (parseFloat(row.querySelector('.line-weight').value) || 0) * (parseFloat(row.querySelector('.line-price').value) || 0);
                    total += amount;
                    row.querySelector('.line-amount').textContent = amount ? 'Rp ' + money.format(amount) : '—';
                });
                document.getElementById('so-total').textContent = 'Rp ' + money.format(total);
            }
            table.addEventListener('input', recalc);
            table.addEventListener('click', function () { setTimeout(recalc, 0); });
            recalc();
        })();
    </script>
}
