@model ListViewModel<Application.Sales.SalesCreditNoteResponse>
@{
    ViewData["Title"] = "Credit Notes";
    ViewData["Menu"] = MenuCodes.SalesCreditNotes;
    bool canExport = await Rights.CanAsync(MenuCodes.SalesCreditNotes, MenuRights.Export);
}
<partial name="Partials/_ListHeader" model='new ListHeaderModel("Credit Notes", "Price or weight corrections on posted invoices; create one from the invoice page", MenuCodes.SalesCreditNotes)' />

<div class="card">
    <div class="card-header">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search number, invoice or customer">
            </div>
            <div class="col-md-3">
                <select name="branch" class="form-select" asp-items="Model.BranchOptions"></select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="ti ti-filter me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-light">Reset</a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light"><tr><th>Number</th><th>Date</th><th>Customer</th><th>Invoice</th><th>Reason</th><th class="text-end">Total</th><th></th></tr></thead>
                <tbody>
                    @foreach (Application.Sales.SalesCreditNoteResponse note in Model.Rows.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@note.Number</td>
                            <td>@Fmt.Date(note.Date)</td>
                            <td>@note.CustomerName</td>
                            <td><a asp-controller="SalesInvoices" asp-action="Details" asp-route-id="@note.SalesInvoiceId">@note.InvoiceNumber</a></td>
                            <td>@note.Reason</td>
                            <td class="text-end text-nowrap">@Fmt.Money(note.Total)</td>
                            <td class="text-end">
                                @if (canExport)
                                {
                                    <a asp-action="Print" asp-route-id="@note.Id" target="_blank" class="btn btn-sm btn-light" title="PDF"><i class="ti ti-file-type-pdf"></i></a>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Rows.Items.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No credit notes found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
