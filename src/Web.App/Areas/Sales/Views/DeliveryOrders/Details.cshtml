@model DeliveryOrderDetailsViewModel
@{
    Application.Sales.DeliveryOrderResponse delivery = Model.Delivery;
    ViewData["Title"] = $"DO {delivery.Number}";
    ViewData["Menu"] = MenuCodes.SalesDeliveries;
}
<div class="page-header">
    <div class="add-item d-flex">
        <div class="page-title">
            <h4 class="fw-bold">DO @delivery.Number <partial name="Partials/_StatusBadge" model="delivery.Status" /></h4>
            <h6>@delivery.CustomerName · SO @delivery.SalesOrderNumber · @delivery.BranchCode</h6>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-light"><i class="ti ti-arrow-left me-1"></i>Back</a>
        @if (Model.CanPrint)
        {
            <a asp-action="Print" asp-route-id="@delivery.Id" target="_blank" class="btn btn-outline-danger"><i class="ti ti-file-type-pdf me-1"></i>Delivery Note</a>
        }
        @if (Model.CanInvoice)
        {
            <a asp-controller="SalesInvoices" asp-action="Create" asp-route-deliveryOrderId="@delivery.Id" class="btn btn-primary"><i class="ti ti-file-invoice me-1"></i>Create Invoice</a>
        }
        @if (Model.CanCancel)
        {
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancel-modal"><i class="ti ti-ban me-1"></i>Cancel DO</button>
        }
    </div>
</div>

@if (delivery.Status == "Cancelled" && delivery.CancellationReason is not null)
{
    <div class="alert alert-danger">Cancelled: @delivery.CancellationReason</div>
}

<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3 mb-2"><div class="text-muted fs-13">Delivery date</div><div class="fw-semibold">@Fmt.Date(delivery.DeliveryDate)</div></div>
            <div class="col-md-3 mb-2"><div class="text-muted fs-13">Vehicle / driver</div><div class="fw-semibold">@(delivery.VehicleNumber ?? "—") / @(delivery.DriverName ?? "—")</div></div>
            <div class="col-md-3 mb-2"><div class="text-muted fs-13">Amount (excl. VAT)</div><div class="fw-semibold">@Fmt.Money(delivery.Amount)</div></div>
            <div class="col-md-3 mb-2">
                <div class="text-muted fs-13">Invoice</div>
                <div class="fw-semibold">
                    @if (delivery.SalesInvoiceId is { } invoiceId)
                    {
                        <a asp-controller="SalesInvoices" asp-action="Details" asp-route-id="@invoiceId">@(delivery.SalesInvoiceNumber ?? "Draft invoice")</a>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(delivery.Notes))
            {
                <div class="col-12"><div class="text-muted fs-13">Notes</div><div style="white-space: pre-line">@delivery.Notes</div></div>
            }
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">Trucks delivered</h5></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead class="thead-light"><tr><th>#</th><th>Item</th><th>Harvest</th><th>Cycle / coop</th><th class="text-end">Birds</th><th class="text-end">kg</th><th class="text-end">Avg</th><th class="text-end">Price/kg</th><th class="text-end">Amount</th><th>VAT</th></tr></thead>
                <tbody>
                    @foreach (Application.Sales.DeliveryOrderLineResponse line in delivery.Lines ?? [])
                    {
                        <tr>
                            <td>@line.LineNumber</td>
                            <td>@line.ItemCode</td>
                            <td>@Fmt.Date(line.HarvestDate)</td>
                            <td>@line.CycleNumber · @line.CoopName</td>
                            <td class="text-end">@Fmt.Number(line.Birds)</td>
                            <td class="text-end">@Fmt.Number(line.WeightKg, 2)</td>
                            <td class="text-end">@Fmt.Number(line.AverageWeightKg, 3)</td>
                            <td class="text-end">@Fmt.Money(line.PricePerKg)</td>
                            <td class="text-end text-nowrap">@Fmt.Money(line.Amount)</td>
                            <td>@(line.TaxCode ?? "—")</td>
                        </tr>
                    }
                </tbody>
                <tfoot><tr><th colspan="4" class="text-end">Total</th><th class="text-end">@Fmt.Number(delivery.Birds)</th><th class="text-end">@Fmt.Number(delivery.WeightKg, 2)</th><th colspan="2"></th><th class="text-end text-nowrap">@Fmt.Money(delivery.Amount)</th><th></th></tr></tfoot>
            </table>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">Attachments</h5></div>
    <div class="card-body"><partial name="Partials/_Attachments" model="new AttachmentsModel(Model.Attachments, false)" /></div>
</div>

<partial name="_ReasonModal" model='new ReasonModalModel("cancel-modal", $"Cancel DO {delivery.Number}", Url.Action("Cancel", new { id = delivery.Id })!, "Cancel DO")' />
