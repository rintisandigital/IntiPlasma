@model SalesInvoiceDetailsViewModel
@{
    Application.Sales.SalesInvoiceResponse invoice = Model.Invoice;
    string number = invoice.Number ?? "(draft)";
    ViewData["Title"] = $"Invoice {number}";
    ViewData["Menu"] = MenuCodes.SalesInvoices;
}
<div class="page-header">
    <div class="add-item d-flex">
        <div class="page-title">
            <h4 class="fw-bold">Invoice @number <partial name="Partials/_StatusBadge" model="invoice.Status" /></h4>
            <h6>@invoice.CustomerName · @invoice.BranchCode</h6>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-light"><i class="ti ti-arrow-left me-1"></i>Back</a>
        @if (Model.CanPrint)
        {
            <a asp-action="Print" asp-route-id="@invoice.Id" target="_blank" class="btn btn-outline-danger"><i class="ti ti-file-type-pdf me-1"></i>Invoice PDF</a>
        }
        @if (Model.CanEdit && Model.IsDraft)
        {
            <form asp-action="Post" asp-route-id="@invoice.Id" method="post" data-confirm="Post the invoice? It gets its number and the receivable is opened.">
                <button type="submit" class="btn btn-success"><i class="ti ti-send me-1"></i>Post</button>
            </form>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancel-modal"><i class="ti ti-ban me-1"></i>Cancel Draft</button>
        }
        @if (Model.CanReceive && Model.IsOpen)
        {
            <a asp-controller="Receipts" asp-action="Create" asp-route-customerId="@invoice.CustomerId" asp-route-salesInvoiceId="@invoice.Id" class="btn btn-primary"><i class="ti ti-cash me-1"></i>Receive Payment</a>
        }
        @if (Model.CanCredit && Model.IsPosted)
        {
            <a asp-controller="CreditNotes" asp-action="Create" asp-route-salesInvoiceId="@invoice.Id" class="btn btn-outline-primary"><i class="ti ti-receipt-refund me-1"></i>Credit Note</a>
        }
    </div>
</div>

@if (invoice.Status == "Cancelled" && invoice.CancellationReason is not null)
{
    <div class="alert alert-danger">Cancelled: @invoice.CancellationReason</div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-2"><div class="text-muted fs-13">Invoice date</div><div class="fw-semibold">@Fmt.Date(invoice.InvoiceDate)</div></div>
                    <div class="col-md-4 mb-2"><div class="text-muted fs-13">Due date</div><div class="fw-semibold">@Fmt.Date(invoice.DueDate)</div></div>
                    <div class="col-md-4 mb-2"><div class="text-muted fs-13">Posted at</div><div class="fw-semibold">@(invoice.PostedAtUtc is { } p ? Fmt.DateTime(p) : "—")</div></div>
                    @if (!string.IsNullOrWhiteSpace(invoice.Notes))
                    {
                        <div class="col-12"><div class="text-muted fs-13">Notes</div><div>@invoice.Notes</div></div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-6 fw-normal">Subtotal</dt><dd class="col-6 text-end">@Fmt.Money(invoice.Subtotal)</dd>
                    <dt class="col-6 fw-normal">VAT</dt><dd class="col-6 text-end">@Fmt.Money(invoice.VatAmount)</dd>
                    <dt class="col-6">Total</dt><dd class="col-6 text-end fw-bold">@Fmt.Money(invoice.Total)</dd>
                    <dt class="col-6 fw-normal">Paid</dt><dd class="col-6 text-end">@Fmt.Money(invoice.PaidAmount)</dd>
                    <dt class="col-6 fw-normal">Credited</dt><dd class="col-6 text-end">@Fmt.Money(invoice.CreditedAmount)</dd>
                    <dt class="col-6">Outstanding</dt><dd class="col-6 text-end fw-bold @(invoice.Outstanding > 0 ? "text-danger" : "text-success")">@Fmt.Money(invoice.Outstanding)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">Lines</h5></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead class="thead-light"><tr><th>#</th><th>DO</th><th>Item</th><th>Cycle</th><th class="text-end">Birds</th><th class="text-end">kg</th><th class="text-end">Price/kg</th><th class="text-end">Amount</th><th>VAT</th><th class="text-end">VAT amount</th></tr></thead>
                <tbody>
                    @foreach (Application.Sales.SalesInvoiceLineResponse line in invoice.Lines ?? [])
                    {
                        <tr>
                            <td>@line.LineNumber</td>
                            <td><a asp-controller="DeliveryOrders" asp-action="Details" asp-route-id="@line.DeliveryOrderId">@line.DeliveryOrderNumber</a></td>
                            <td>@line.ItemCode</td>
                            <td>@line.CycleNumber</td>
                            <td class="text-end">@Fmt.Number(line.Birds)</td>
                            <td class="text-end">@Fmt.Number(line.WeightKg, 2)</td>
                            <td class="text-end">@Fmt.Money(line.PricePerKg)</td>
                            <td class="text-end text-nowrap">@Fmt.Money(line.Amount)</td>
                            <td>@(line.TaxCode is null ? "—" : $"{line.TaxCode} {Fmt.Number(line.VatRatePercent, 2)}%")</td>
                            <td class="text-end text-nowrap">@Fmt.Money(line.VatAmount)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.CreditNotes.Count > 0)
{
    <div class="card">
        <div class="card-header"><h5 class="card-title mb-0">Credit notes</h5></div>
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead class="thead-light"><tr><th>Number</th><th>Date</th><th>Reason</th><th class="text-end">Total</th><th></th></tr></thead>
                <tbody>
                    @foreach (Application.Sales.SalesCreditNoteResponse note in Model.CreditNotes)
                    {
                        <tr>
                            <td>@note.Number</td>
                            <td>@Fmt.Date(note.Date)</td>
                            <td>@note.Reason</td>
                            <td class="text-end">@Fmt.Money(note.Total)</td>
                            <td class="text-end">
                                <a asp-controller="CreditNotes" asp-action="Print" asp-route-id="@note.Id" asp-menu="@MenuCodes.SalesCreditNotes" asp-right="Export"
                                   target="_blank" class="btn btn-sm btn-light" title="PDF"><i class="ti ti-file-type-pdf"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<partial name="_ReasonModal" model='new ReasonModalModel("cancel-modal", "Cancel draft invoice", Url.Action("Cancel", new { id = invoice.Id })!, "Cancel Invoice")' />
