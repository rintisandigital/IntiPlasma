@model ReceiptDetailsViewModel
@{
    Application.Finance.Receivables.CustomerReceiptResponse receipt = Model.Receipt;
    ViewData["Title"] = $"Receipt {receipt.Number}";
    ViewData["Menu"] = MenuCodes.SalesReceipts;
}
<div class="page-header">
    <div class="add-item d-flex">
        <div class="page-title">
            <h4 class="fw-bold">Receipt @receipt.Number <partial name="Partials/_StatusBadge" model="receipt.Status" /></h4>
            <h6>@receipt.CustomerName · @receipt.BranchCode</h6>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-light"><i class="ti ti-arrow-left me-1"></i>Back</a>
        @if (Model.CanPrint)
        {
            <a asp-action="Print" asp-route-id="@receipt.Id" target="_blank" class="btn btn-outline-danger"><i class="ti ti-file-type-pdf me-1"></i>Receipt PDF</a>
        }
        @if (Model.CanEdit && Model.CanBeVoided)
        {
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#void-modal"><i class="ti ti-ban me-1"></i>Void</button>
        }
    </div>
</div>

@if (receipt.VoidDate is { } voided)
{
    <div class="alert alert-danger">Voided on @Fmt.Date(voided): @receipt.VoidReason</div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-2"><div class="text-muted fs-13">Date</div><div class="fw-semibold">@Fmt.Date(receipt.ReceiptDate)</div></div>
                    <div class="col-md-4 mb-2"><div class="text-muted fs-13">Into</div><div class="fw-semibold">@(receipt.CashBankCode ?? receipt.CashAccountCode) — @receipt.CashAccountName</div></div>
                    <div class="col-md-4 mb-2"><div class="text-muted fs-13">Reference</div><div class="fw-semibold">@(receipt.Reference ?? "—")</div></div>
                    @if (!string.IsNullOrWhiteSpace(receipt.Notes))
                    {
                        <div class="col-12"><div class="text-muted fs-13">Notes</div><div>@receipt.Notes</div></div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-7">Total received</dt><dd class="col-5 text-end fw-bold">@Fmt.Money(receipt.Amount)</dd>
                    <dt class="col-7 fw-normal">Advance</dt><dd class="col-5 text-end">@Fmt.Money(receipt.AdvanceAmount)</dd>
                    <dt class="col-7 fw-normal">Advance applied</dt><dd class="col-5 text-end">@Fmt.Money(receipt.AppliedAdvanceAmount)</dd>
                    <dt class="col-7 fw-normal">Advance left</dt><dd class="col-5 text-end @(receipt.UnappliedAdvance > 0 ? "text-primary fw-semibold" : "")">@Fmt.Money(receipt.UnappliedAdvance)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">Invoices paid</h5></div>
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead class="thead-light"><tr><th>Invoice</th><th>Date</th><th>Source</th><th class="text-end">Amount</th></tr></thead>
            <tbody>
                @foreach (Application.Finance.Receivables.CustomerReceiptAllocationResponse allocation in receipt.Allocations ?? [])
                {
                    <tr>
                        <td><a asp-controller="SalesInvoices" asp-action="Details" asp-route-id="@allocation.SalesInvoiceId">@allocation.InvoiceNumber</a></td>
                        <td>@Fmt.Date(allocation.InvoiceDate)</td>
                        <td>Receipt</td>
                        <td class="text-end">@Fmt.Money(allocation.Amount)</td>
                    </tr>
                }
                @foreach (Application.Finance.Receivables.AdvanceApplicationResponse application in receipt.Applications ?? [])
                {
                    <tr>
                        <td><a asp-controller="SalesInvoices" asp-action="Details" asp-route-id="@application.SalesInvoiceId">@application.InvoiceNumber</a></td>
                        <td>@Fmt.Date(application.Date)</td>
                        <td>Advance applied</td>
                        <td class="text-end">@Fmt.Money(application.Amount)</td>
                    </tr>
                }
                @if ((receipt.Allocations ?? []).Count == 0 && (receipt.Applications ?? []).Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-3">Advance only — not applied to invoices yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.CanEdit && Model.HasAdvanceLeft)
{
    <form asp-action="ApplyAdvance" asp-route-id="@receipt.Id" method="post">
        <div class="card border-primary">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="card-title mb-0">Apply the advance (@Fmt.Money(receipt.UnappliedAdvance) left)</h5>
                <div class="d-flex align-items-center gap-2">
                    <label for="apply-date" class="form-label mb-0">Date</label>
                    <input id="apply-date" type="date" name="date" value="@Fmt.Today().ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm" style="width: 10rem">
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead class="thead-light"><tr><th>Invoice</th><th>Due</th><th class="text-end">Outstanding</th><th style="width: 20%">Apply</th></tr></thead>
                    <tbody>
                        @for (int i = 0; i < Model.OpenInvoices.Count; i++)
                        {
                            Application.Finance.Receivables.InvoiceAging invoice = Model.OpenInvoices[i];
                            <tr>
                                <td>@invoice.Number <span class="text-muted fs-12">@invoice.BranchCode</span></td>
                                <td>@Fmt.Date(invoice.DueDate)</td>
                                <td class="text-end">@Fmt.Money(invoice.Outstanding)</td>
                                <td>
                                    <input type="hidden" name="allocations[@i].SalesInvoiceId" value="@invoice.SalesInvoiceId">
                                    <input type="number" name="allocations[@i].Amount" min="0" step="0.01"
                                           max="@Math.Min(invoice.Outstanding, receipt.UnappliedAdvance).ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm text-end">
                                </td>
                            </tr>
                        }
                        @if (Model.OpenInvoices.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">No open invoice of this customer.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.OpenInvoices.Count > 0)
            {
                <div class="card-footer text-end"><button type="submit" class="btn btn-primary"><i class="ti ti-arrows-exchange me-1"></i>Apply Advance</button></div>
            }
        </div>
    </form>
}

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">Attachments</h5></div>
    <div class="card-body"><partial name="Partials/_Attachments" model="new AttachmentsModel(Model.Attachments, false)" /></div>
</div>

<partial name="Partials/_ReasonModal" model='new ReasonModalModel("void-modal", $"Void receipt {receipt.Number}", Url.Action("Void", new { id = receipt.Id })!, "Void Receipt", WithDate: true)' />

@await Component.InvokeAsync("JournalPreview", new { sourceIds = (receipt.Applications ?? []).Select(a => a.Id).Prepend(receipt.Id) })
