@model SettlementDetailsViewModel
@{
    Application.Costing.PlasmaSettlementResponse settlement = Model.Settlement;
    ViewData["Title"] = $"Settlement {settlement.Number}";
    ViewData["Menu"] = MenuCodes.CostingSettlements;
    Domain.Partnership.Cycles.CyclePerformance? performance = settlement.Performance;
    string approval = "—";
    if (settlement.ApprovedAtUtc is { } approvedAt)
    {
        approval = settlement.ApprovedByName is null ? Fmt.DateTime(approvedAt) : $"{Fmt.DateTime(approvedAt)} by {settlement.ApprovedByName}";
    }
}
<div class="page-header">
    <div class="add-item d-flex">
        <div class="page-title">
            <h4 class="fw-bold">Settlement @settlement.Number <partial name="Partials/_StatusBadge" model="settlement.Status" /></h4>
            <h6>@settlement.FarmerName (@settlement.FarmerCode) · cycle @settlement.CycleNumber · @settlement.BranchCode</h6>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-light"><i class="ti ti-arrow-left me-1"></i>Back</a>
        <a asp-controller="CycleCosts" asp-action="Details" asp-route-id="@settlement.CycleId" class="btn btn-outline-primary"><i class="ti ti-calculator me-1"></i>Cycle cost</a>
        @if (Model.CanPrint)
        {
            <a asp-action="Print" asp-route-id="@settlement.Id" target="_blank" class="btn btn-outline-danger"><i class="ti ti-file-type-pdf me-1"></i>Settlement PDF</a>
        }
        @if (Model.CanEdit && Model.IsDraft)
        {
            <a asp-action="Recalculate" asp-route-id="@settlement.Id" class="btn btn-outline-primary"><i class="ti ti-refresh me-1"></i>Recalculate</a>
            <form asp-action="Approve" asp-route-id="@settlement.Id" method="post"
                  data-confirm="Approve settlement @settlement.Number? It is journaled and the cycle becomes settled. The maker cannot approve their own settlement.">
                <button type="submit" class="btn btn-success"><i class="ti ti-check me-1"></i>Approve</button>
            </form>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancel-modal"><i class="ti ti-ban me-1"></i>Cancel</button>
        }
        @if (Model.CanPay && Model.IsPayable)
        {
            <a asp-area="Finance" asp-controller="PaymentVouchers" asp-action="Create" asp-route-payeeType="Farmer" asp-route-payeeId="@settlement.FarmerId"
               asp-route-documentId="@settlement.Id" class="btn btn-primary"><i class="ti ti-cash me-1"></i>Pay</a>
        }
    </div>
</div>

@if (settlement.Status == "Cancelled" && settlement.CancellationReason is not null)
{
    <div class="alert alert-danger">Cancelled: @settlement.CancellationReason</div>
}
@if (Model.IsDraft)
{
    <div class="alert alert-info">
        Draft calculated @Fmt.DateTime(settlement.CalculatedAtUtc)@(settlement.CreatedByName is null ? "" : $" by {settlement.CreatedByName}").
        Recalculate after correcting the cycle (e.g. a new credit note); another user must approve it (maker-checker).
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-2"><div class="text-muted fs-13">Settlement date</div><div class="fw-semibold">@Fmt.Date(settlement.SettlementDate)</div></div>
                    <div class="col-md-4 mb-2"><div class="text-muted fs-13">Contract</div><div class="fw-semibold">@settlement.ContractCode · @SettlementLines.Scheme(settlement.Scheme)</div></div>
                    <div class="col-md-4 mb-2"><div class="text-muted fs-13">Farm</div><div class="fw-semibold">@settlement.CoopCode — @settlement.CoopName</div></div>
                    <div class="col-md-4 mb-2">
                        <div class="text-muted fs-13">Cycle</div>
                        <div class="fw-semibold"><a asp-area="Production" asp-controller="Cycles" asp-action="Details" asp-route-id="@settlement.CycleId">@settlement.CycleNumber</a> <partial name="Partials/_StatusBadge" model="settlement.CycleStatus" /></div>
                    </div>
                    <div class="col-md-4 mb-2"><div class="text-muted fs-13">Chick-in / closed</div><div class="fw-semibold">@(settlement.ChickInDate is { } chickIn ? Fmt.Date(chickIn) : "—") – @(settlement.ClosedDate is { } closed ? Fmt.Date(closed) : "—")</div></div>
                    <div class="col-md-4 mb-2"><div class="text-muted fs-13">Approved</div><div class="fw-semibold">@approval</div></div>
                    @if (!string.IsNullOrWhiteSpace(settlement.Notes))
                    {
                        <div class="col-12"><div class="text-muted fs-13">Notes</div><div style="white-space: pre-line">@settlement.Notes</div></div>
                    }
                </div>
            </div>
        </div>
        @if (performance is not null)
        {
            <div class="row g-3 mb-3">
                @foreach ((string label, string value) in new[]
                {
                    ("Initial population", Fmt.Number(performance.InitialPopulation)),
                    ("Harvested", $"{Fmt.Number(performance.HarvestedBirds)} / {Fmt.Number(performance.HarvestedWeightKg, 0)} kg"),
                    ("Depletion", $"{Fmt.Number(performance.DepletionPercent, 2)} %"),
                    ("Avg. weight", performance.AverageWeightKg is { } bw ? $"{Fmt.Number(bw, 3)} kg" : "—"),
                    ("FCR", performance.Fcr is { } fcr ? Fmt.Number(fcr, 3) : "—"),
                    ("IP", performance.Ip is { } ip ? Fmt.Number(ip, 0) : "—")
                })
                {
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card mb-0 h-100"><div class="card-body py-2">
                            <div class="text-muted fs-12">@label</div>
                            <div class="fw-bold">@value</div>
                        </div></div>
                    </div>
                }
            </div>
        }
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-7 fw-normal">Gross income</dt><dd class="col-5 text-end fw-semibold @(Model.IsLoss ? "text-danger" : "")">@Fmt.Money(settlement.GrossIncome)</dd>
                    @if (Model.IsLoss)
                    {
                        <dt class="col-7">Loss → plasma debt</dt><dd class="col-5 text-end fw-bold text-danger">@Fmt.Money(settlement.Deficit)</dd>
                    }
                    else
                    {
                        <dt class="col-7 fw-normal">Income tax @(settlement.IncomeTaxCode is { } tax ? $"{tax} ({Fmt.Number(settlement.IncomeTaxRatePercent)}%)" : "")</dt>
                        <dd class="col-5 text-end">−@Fmt.Money(settlement.IncomeTaxAmount)</dd>
                        <dt class="col-7 fw-normal">Debt deduction</dt><dd class="col-5 text-end">−@Fmt.Money(settlement.DebtDeduction)</dd>
                        <dt class="col-7">Net payable</dt><dd class="col-5 text-end fw-bold">@Fmt.Money(settlement.NetPayable)</dd>
                        <dt class="col-7 fw-normal">Paid</dt><dd class="col-5 text-end">@Fmt.Money(settlement.PaidAmount)</dd>
                        <dt class="col-7">Outstanding</dt><dd class="col-5 text-end fw-bold">@Fmt.Money(settlement.Outstanding)</dd>
                    }
                </dl>
            </div>
        </div>
        @if (Model.FarmerDebt is { Balance: > 0 } debt)
        {
            <div class="alert alert-warning">Plasma debt from earlier settlements: <strong>@Fmt.Money(debt.Balance)</strong>. Deduct it with Recalculate if agreed.</div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">Calculation</h5></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead class="thead-light"><tr><th style="width: 4%">#</th><th>Description</th><th class="text-end">Quantity</th><th class="text-end">Unit price</th><th class="text-end">Amount</th></tr></thead>
                <tbody>
                    @foreach (IGrouping<string, Application.Costing.PlasmaSettlementLineResponse> group in Model.LineGroups)
                    {
                        <tr class="table-light"><td colspan="4" class="fw-semibold">@SettlementLines.Title(group.Key)</td><td class="text-end fw-semibold">@Fmt.Money(group.Sum(l => l.Amount))</td></tr>
                        @foreach (Application.Costing.PlasmaSettlementLineResponse line in group)
                        {
                            <tr>
                                <td>@line.LineNumber</td>
                                <td>@line.Description</td>
                                <td class="text-end">@(line.Quantity is { } q ? Fmt.Number(q, 3) : "")</td>
                                <td class="text-end">@(line.UnitPrice is { } p ? Fmt.Money(p) : "")</td>
                                <td class="text-end @(line.Amount < 0 ? "text-danger" : "")">@Fmt.Money(line.Amount)</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot><tr><th colspan="4" class="text-end">Gross income</th><th class="text-end">@Fmt.Money(settlement.GrossIncome)</th></tr></tfoot>
            </table>
        </div>
    </div>
</div>

<partial name="Partials/_AttachmentsCard" model='new AttachmentsCardModel(Model.Attachments, Model.CanEdit && settlement.Status != "Cancelled" ? Url.Action("Documents", new { id = settlement.Id }) : null)' />

<partial name="Partials/_ReasonModal" model='new ReasonModalModel("cancel-modal", $"Cancel settlement {settlement.Number}", Url.Action("Cancel", new { id = settlement.Id })!, "Cancel Settlement")' />

@await Component.InvokeAsync("JournalPreview", new { sourceIds = new[] { settlement.Id }, emptyText = "No journal yet — the settlement is journaled when it is approved." })
