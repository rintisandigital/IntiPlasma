@model ListViewModel<Application.Warehouses.WarehouseResponse>
@{
    ViewData["Title"] = "Warehouses";
    ViewData["Menu"] = MenuCodes.MasterWarehouses;
}
<partial name="Partials/_ListHeader" model='new ListHeaderModel("Warehouses", "Central warehouses per branch; coop warehouses are created with their coop", MenuCodes.MasterWarehouses, "Add Warehouse")' />

<div class="card">
    <div class="card-header">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search code or name">
            </div>
            <div class="col-md-3">
                <select name="branch" class="form-select" asp-items="Model.BranchOptions"></select>
            </div>
            <div class="col-md-2">
                <select name="type" class="form-select" asp-items='Model.FilterOptions["type"]'>
                    <option value="">All types</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="ti ti-filter me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-light">Reset</a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr><th>Code</th><th>Name</th><th>Branch</th><th>Type</th><th>Coop</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (Application.Warehouses.WarehouseResponse warehouse in Model.Rows.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@warehouse.Code</td>
                            <td>@warehouse.Name</td>
                            <td>@warehouse.BranchCode</td>
                            <td>@warehouse.Type</td>
                            <td>@(warehouse.CoopCode ?? "—")</td>
                            <td><partial name="Partials/_StatusBadge" model='warehouse.IsActive ? "Active" : "Inactive"' /></td>
                            <td class="text-end"><a asp-action="Edit" asp-route-id="@warehouse.Id" class="btn btn-sm btn-light" title="Open"><i class="ti ti-eye"></i></a></td>
                        </tr>
                    }
                    @if (Model.Rows.Items.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No warehouses found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="Partials/_Pagination" model="PaginationModel.From(Model.Rows)" />
    </div>
</div>
