@model WarehouseFormViewModel
@{
    ViewData["Title"] = Model.IsNew ? "Add Warehouse" : $"Warehouse {Model.Code}";
    ViewData["Menu"] = MenuCodes.MasterWarehouses;
}
<partial name="Partials/_PageHeader" model='new PageHeaderModel(Model.IsNew ? "Add Warehouse" : $"Warehouse {Model.Code}", Model.CoopCode is null ? "Central warehouse (gudang induk)" : $"Coop warehouse of {Model.CoopCode}")' />

<div class="row">
    <div class="col-xl-7 col-lg-9">
        <form asp-action="@(Model.IsNew ? "Create" : "Edit")" method="post">
            @if (Model.IsNew)
            {
                <form-token />
            }
            else
            {
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Code" />
                <input type="hidden" asp-for="BranchId" />
            }
            <fieldset disabled="@(!Model.CanSave)">
                <div class="card">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Code" class="form-label"></label> <span class="text-danger">*</span>
                                <input asp-for="Code" class="form-control text-uppercase" disabled="@(!Model.IsNew)">
                                <span asp-validation-for="Code" class="text-danger fs-13"></span>
                            </div>
                            <div class="col-md-8 mb-3">
                                <label asp-for="Name" class="form-label"></label> <span class="text-danger">*</span>
                                <input asp-for="Name" class="form-control">
                                <span asp-validation-for="Name" class="text-danger fs-13"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="BranchId" class="form-label"></label> <span class="text-danger">*</span>
                                <select asp-for="BranchId" class="form-select" asp-items="Model.Branches" disabled="@(!Model.IsNew)">
                                    <option value="">—</option>
                                </select>
                                <span asp-validation-for="BranchId" class="text-danger fs-13"></span>
                            </div>
                            <div class="col-12 mb-3">
                                <label asp-for="Address" class="form-label"></label>
                                <input asp-for="Address" class="form-control">
                            </div>
                            @if (!Model.IsNew)
                            {
                                <div class="col-12">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" id="IsActive" name="IsActive" value="true" checked="@(Model.IsActive == true)">
                                        <label class="form-check-label" for="IsActive">Active</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </fieldset>
            <partial name="Partials/_FormButtons" model='new FormButtonsModel(Model.CanSave, Url.Action("Index")!)' />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
