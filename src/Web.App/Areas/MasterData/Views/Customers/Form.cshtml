@model CustomerFormViewModel
@{
    ViewData["Title"] = Model.IsNew ? "Add Customer" : $"Customer {Model.Code}";
    ViewData["Menu"] = MenuCodes.MasterCustomers;
}
<partial name="Partials/_PageHeader" model='new PageHeaderModel(Model.IsNew ? "Add Customer" : $"Customer {Model.Code}", "Buyer of live birds; credit limit 0 = no credit")' />

<form asp-action="@(Model.IsNew ? "Create" : "Edit")" method="post">
    @if (Model.IsNew)
    {
        <form-token />
    }
    else
    {
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Code" />
    }
    <fieldset disabled="@(!Model.CanSave)">
        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0">Customer</h5></div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label asp-for="Code" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="Code" class="form-control text-uppercase" disabled="@(!Model.IsNew)">
                        <span asp-validation-for="Code" class="text-danger fs-13"></span>
                    </div>
                    <div class="col-md-9 mb-3">
                        <label asp-for="Name" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="Name" class="form-control">
                        <span asp-validation-for="Name" class="text-danger fs-13"></span>
                    </div>
                    <div class="col-12 mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address" class="form-control">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control">
                        <span asp-validation-for="Email" class="text-danger fs-13"></span>
                    </div>
                    <div class="col-md-2 mb-3">
                        <label asp-for="PaymentTermDays" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="PaymentTermDays" type="number" min="0" max="365" class="form-control">
                        <span asp-validation-for="PaymentTermDays" class="text-danger fs-13"></span>
                    </div>
                    <div class="col-md-2 mb-3">
                        <label asp-for="CreditLimit" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="CreditLimit" type="number" step="0.01" min="0" class="form-control">
                        <span asp-validation-for="CreditLimit" class="text-danger fs-13"></span>
                    </div>
                    @if (!Model.IsNew)
                    {
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="IsActive" name="IsActive" value="true" checked="@(Model.IsActive == true)">
                                <label class="form-check-label" for="IsActive">Active</label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0">Tax identity</h5></div>
            <div class="card-body pb-0"><partial name="Partials/_TaxIdentityFields" for="TaxIdentity" /></div>
        </div>
    </fieldset>

    <div class="card">
        <div class="card-header"><h5 class="card-title mb-0">Attachments</h5></div>
        <div class="card-body"><partial name="Partials/_Attachments" model="new AttachmentsModel(Model.Attachments, Model.CanSave)" /></div>
    </div>

    <partial name="Partials/_FormButtons" model='new FormButtonsModel(Model.CanSave, Url.Action("Index")!)' />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
