@model ListViewModel<Application.Vendors.VendorResponse>
@{
    ViewData["Title"] = "Vendors";
    ViewData["Menu"] = MenuCodes.MasterVendors;
}
<partial name="Partials/_ListHeader" model='new ListHeaderModel("Vendors", "Sapronak suppliers", MenuCodes.MasterVendors, "Add Vendor")' />

<div class="card">
    <div class="card-header">
        <partial name="Partials/_FilterBar" model='new FilterBarModel(Model.Search, "Search code or name")' />
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr><th>Code</th><th>Name</th><th>NPWP</th><th>Phone</th><th class="text-end">Term</th><th class="text-end">Tolerance</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (Application.Vendors.VendorResponse vendor in Model.Rows.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@vendor.Code</td>
                            <td>@vendor.Name @if (vendor.TaxIdentity.IsPkp) { <span class="badge bg-light text-dark ms-1">PKP</span> }</td>
                            <td>@(vendor.TaxIdentity.Npwp ?? "—")</td>
                            <td>@(vendor.Phone ?? "—")</td>
                            <td class="text-end">@vendor.PaymentTermDays days</td>
                            <td class="text-end">@Fmt.Number(vendor.PriceTolerancePercent)%</td>
                            <td><partial name="Partials/_StatusBadge" model='vendor.IsActive ? "Active" : "Inactive"' /></td>
                            <td class="text-end"><a asp-action="Edit" asp-route-id="@vendor.Id" class="btn btn-sm btn-light" title="Open"><i class="ti ti-eye"></i></a></td>
                        </tr>
                    }
                    @if (Model.Rows.Items.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No vendors found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="Partials/_Pagination" model="PaginationModel.From(Model.Rows)" />
    </div>
</div>
