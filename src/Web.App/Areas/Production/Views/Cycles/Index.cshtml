@model ListViewModel<Application.Cycles.CycleResponse>
@{
    ViewData["Title"] = "Cycles & Chick-in";
    ViewData["Menu"] = MenuCodes.ProductionCycles;
}
<partial name="Partials/_ListHeader" model='new ListHeaderModel("Production Cycles", "Plan a cycle, place DOC (chick-in), record, harvest and close", MenuCodes.ProductionCycles, "Plan Cycle")' />

<div class="card">
    <div class="card-header">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search cycle number">
            </div>
            <div class="col-md-3">
                <select name="branch" class="form-select" asp-items="Model.BranchOptions" aria-label="Branch"></select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select" asp-items='Model.FilterOptions["status"]'>
                    <option value="">All statuses</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="ti ti-filter me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-light">Reset</a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr><th>Cycle</th><th>Farm</th><th>Farmer</th><th>Chick-in</th><th class="text-end">Population</th><th class="text-end">Harvested</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (Application.Cycles.CycleResponse cycle in Model.Rows.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@cycle.Number</td>
                            <td>@cycle.CoopCode — @cycle.CoopName</td>
                            <td>@cycle.FarmerName <span class="text-muted fs-12">@cycle.FarmerType</span></td>
                            <td>@(cycle.ChickInDate is { } chickIn ? Fmt.Date(chickIn) : $"planned {Fmt.Date(cycle.PlannedChickInDate)}")</td>
                            <td class="text-end">@Fmt.Number(cycle.InitialPopulation is null ? cycle.PlannedPopulation : cycle.CurrentPopulation)</td>
                            <td class="text-end text-nowrap">@Fmt.Number(cycle.HarvestedBirds) / @Fmt.Number(cycle.HarvestedWeightKg, 0) kg</td>
                            <td><partial name="Partials/_StatusBadge" model="cycle.Status" /></td>
                            <td class="text-end"><a asp-action="Details" asp-route-id="@cycle.Id" class="btn btn-sm btn-light" title="Open"><i class="ti ti-eye"></i></a></td>
                        </tr>
                    }
                    @if (Model.Rows.Items.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No cycles found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="Partials/_Pagination" model="PaginationModel.From(Model.Rows)" />
    </div>
</div>
