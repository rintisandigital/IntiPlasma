@model PlanCycleFormViewModel
@{
    ViewData["Title"] = "Plan Cycle";
    ViewData["Menu"] = MenuCodes.ProductionCycles;
}
<partial name="Partials/_PageHeader" model='new PageHeaderModel("Plan Cycle", "Step 1 of the cycle: choose the coop and, for a plasma coop, its partnership contract (the terms are frozen in the cycle)")' />

<div class="row">
    <div class="col-xl-8">
        <form asp-action="Create" method="post">
            <form-token />
            <div class="card">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label asp-for="CoopId" class="form-label"></label> <span class="text-danger">*</span>
                            <input type="hidden" asp-for="CoopLabel" id="coop-label" />
                            <select asp-for="CoopId" id="CoopId" class="form-select" data-lookup="@Url.Action("PlannableCoops", "Lookup", new { area = "" })"
                                    data-copy-label="#coop-label">
                                <option value="">Search a coop without a running cycle…</option>
                                @if (Model.CoopId is not null)
                                {
                                    <option value="@Model.CoopId" selected>@Model.CoopLabel</option>
                                }
                            </select>
                            <span asp-validation-for="CoopId" class="text-danger fs-13"></span>
                        </div>
                        <div class="col-12 mb-3">
                            <label asp-for="ContractId" class="form-label"></label>
                            <input type="hidden" asp-for="ContractLabel" id="contract-label" />
                            <select asp-for="ContractId" class="form-select" data-lookup="@Url.Action("CoopContracts", "Lookup", new { area = "" })"
                                    data-lookup-depends="coopId:#CoopId"
                                    data-copy-label="#contract-label">
                                <option value="">— None (inti coop) —</option>
                                @if (Model.ContractId is not null)
                                {
                                    <option value="@Model.ContractId" selected>@Model.ContractLabel</option>
                                }
                            </select>
                            <div class="form-text">Required for a plasma coop (active contracts of the coop's branch); leave empty for an inti coop.</div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="PlannedChickInDate" class="form-label"></label> <span class="text-danger">*</span>
                            <input asp-for="PlannedChickInDate" type="date" class="form-control">
                            <span asp-validation-for="PlannedChickInDate" class="text-danger fs-13"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="PlannedPopulation" class="form-label"></label> <span class="text-danger">*</span>
                            <input asp-for="PlannedPopulation" type="number" min="1" step="1" class="form-control">
                            <span asp-validation-for="PlannedPopulation" class="text-danger fs-13"></span>
                        </div>
                        <div class="col-12 mb-3">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" rows="2" class="form-control"></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <partial name="Partials/_FormButtons" model='new FormButtonsModel(true, Url.Action("Index")!, "Plan Cycle")' />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
