@model CycleWorkspaceViewModel
@{
    ViewData["Title"] = "Daily Recordings";
    ViewData["Menu"] = MenuCodes.ProductionRecordings;
    Application.Cycles.CycleResponse? cycle = Model.Cycle;
    bool recordable = cycle is { Status: "Active" or "Harvesting" };
    bool canExport = await Rights.CanAsync(MenuCodes.ProductionRecordings, MenuRights.Export);
}
<div class="page-header">
    <div class="add-item d-flex">
        <div class="page-title">
            <h4 class="fw-bold">Daily Recordings</h4>
            <h6>Mortality, culling, body weight and feed/OVK used per day (admin entry, backup of the PPL app)</h6>
        </div>
    </div>
    @if (cycle is not null)
    {
        <div class="d-flex flex-wrap gap-2">
            @if (canExport)
            {
                <a asp-action="Export" asp-route-format="xlsx" asp-route-cycleId="@cycle.Id" target="_blank" class="btn btn-outline-success"><i class="ti ti-file-spreadsheet me-1"></i>Excel</a>
                <a asp-action="Export" asp-route-format="pdf" asp-route-cycleId="@cycle.Id" target="_blank" class="btn btn-outline-danger"><i class="ti ti-file-type-pdf me-1"></i>PDF</a>
            }
            @if (recordable && Model.CanCreate)
            {
                <a asp-action="Create" asp-route-cycleId="@cycle.Id" class="btn btn-primary"><i class="ti ti-clipboard-plus me-1"></i>New Recording</a>
            }
        </div>
    }
</div>

<partial name="_CyclePicker" model="Model" />

@if (cycle is not null)
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="thead-light"><tr><th>Date</th><th class="text-end">Age (days)</th><th class="text-end">Mortality</th><th class="text-end">Culling</th><th class="text-end">BW (g)</th><th class="text-end">Feed (kg)</th><th>Revision</th><th>Notes</th><th></th></tr></thead>
                    <tbody>
                        @foreach (Application.Production.DailyRecordingResponse recording in Model.Recordings)
                        {
                            <tr>
                                <td class="fw-semibold">@Fmt.Date(recording.Date)</td>
                                <td class="text-end">@recording.AgeDays</td>
                                <td class="text-end">@Fmt.Number(recording.Mortality)</td>
                                <td class="text-end">@Fmt.Number(recording.Culling)</td>
                                <td class="text-end">@(recording.AverageBodyWeightGram is { } g ? Fmt.Number(g, 0) : "—")</td>
                                <td class="text-end">@Fmt.Number(recording.FeedKg, 1)</td>
                                <td>@(recording.RevisionNumber > 0 ? $"rev. {recording.RevisionNumber}" : "—")</td>
                                <td class="text-truncate" style="max-width: 16rem">@recording.Notes</td>
                                <td class="text-end"><a asp-action="Details" asp-route-id="@recording.Id" class="btn btn-sm btn-light" title="Open"><i class="ti ti-eye"></i></a></td>
                            </tr>
                        }
                        @if (Model.Recordings.Count == 0)
                        {
                            <tr><td colspan="9" class="text-center text-muted py-4">No recording yet for this cycle.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
