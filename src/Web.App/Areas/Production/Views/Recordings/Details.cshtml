@model RecordingDetailsViewModel
@using System.Text.Json
@{
    Application.Production.DailyRecordingResponse recording = Model.Recording;
    ViewData["Title"] = $"Recording {Fmt.Date(recording.Date)}";
    ViewData["Menu"] = MenuCodes.ProductionRecordings;
}
<div class="page-header">
    <div class="add-item d-flex">
        <div class="page-title">
            <h4 class="fw-bold">Recording @Fmt.Date(recording.Date) <span class="badge bg-light text-dark">day @recording.AgeDays</span>
                @if (recording.RevisionNumber > 0)
                {
                    <span class="badge bg-warning text-dark">rev. @recording.RevisionNumber</span>
                }
            </h4>
            <h6>@Model.Cycle.Number · @Model.Cycle.CoopCode @Model.Cycle.CoopName</h6>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" asp-route-cycleId="@recording.CycleId" class="btn btn-light"><i class="ti ti-arrow-left me-1"></i>Back</a>
        @if (Model.CanRevise)
        {
            <a asp-action="Revise" asp-route-id="@recording.Id" class="btn btn-outline-primary"><i class="ti ti-edit me-1"></i>Revise</a>
        }
    </div>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-4 mb-2"><div class="text-muted fs-13">Mortality</div><div class="fw-semibold fs-16">@Fmt.Number(recording.Mortality)</div></div>
                    <div class="col-4 mb-2"><div class="text-muted fs-13">Culling</div><div class="fw-semibold fs-16">@Fmt.Number(recording.Culling)</div></div>
                    <div class="col-4 mb-2"><div class="text-muted fs-13">Body weight</div><div class="fw-semibold fs-16">@(recording.AverageBodyWeightGram is { } g ? $"{Fmt.Number(g, 0)} g" : "—")</div></div>
                    @if (!string.IsNullOrWhiteSpace(recording.Notes))
                    {
                        <div class="col-12"><div class="text-muted fs-13">Notes</div><div style="white-space: pre-line">@recording.Notes</div></div>
                    }
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0">Feed &amp; OVK used</h5></div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="thead-light"><tr><th>Item</th><th class="text-end">Quantity</th><th class="text-end">Base quantity</th><th class="text-end">Value</th></tr></thead>
                    <tbody>
                        @foreach (Application.Production.UsageResponse usage in recording.Usages ?? [])
                        {
                            <tr>
                                <td>@usage.ItemCode — @usage.ItemName</td>
                                <td class="text-end">@Fmt.Number(usage.Quantity, 3) @usage.UomCode</td>
                                <td class="text-end">@Fmt.Number(usage.BaseQuantity, 3) @usage.BaseUomCode</td>
                                <td class="text-end">@Fmt.Money(usage.Value)</td>
                            </tr>
                        }
                        @if ((recording.Usages ?? []).Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">No usage.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0">Attachments</h5></div>
            <div class="card-body"><partial name="Partials/_Attachments" model="new AttachmentsModel(Model.Attachments, false)" /></div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0">History</h5></div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    @foreach (Application.Production.RevisionResponse revision in recording.Revisions ?? [])
                    {
                        <li class="border-start border-3 border-warning ps-3 pb-3">
                            <div class="fw-semibold">Revision @revision.RevisionNumber · @Fmt.DateTime(revision.RevisedAtUtc)</div>
                            <div class="mb-1">@revision.Reason</div>
                            @if (revision.PreviousValues.ValueKind == JsonValueKind.Object)
                            {
                                <div class="text-muted fs-12">Before:
                                    @string.Join(" · ", revision.PreviousValues.EnumerateObject()
                                        .Where(p => p.Value.ValueKind is JsonValueKind.Number or JsonValueKind.String)
                                        .Select(p => $"{p.Name}: {p.Value}"))
                                </div>
                            }
                        </li>
                    }
                    <li class="border-start border-3 border-success ps-3">
                        <div class="fw-semibold">Recorded · @Fmt.DateTime(recording.CreatedAtUtc)</div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
