@model UserCreateViewModel
@{
    ViewData["Title"] = "Add User";
    ViewData["Menu"] = MenuCodes.AdminUsers;
}
<div class="page-header">
    <div class="add-item d-flex">
        <div class="page-title">
            <h4 class="fw-bold">Add User</h4>
            <h6>The user signs in with the initial password below</h6>
        </div>
    </div>
    <div class="page-btn">
        <a asp-action="Index" class="btn btn-light"><i class="ti ti-arrow-left me-1"></i>Back</a>
    </div>
</div>

<form asp-action="Create" method="post" autocomplete="off">
    <form-token />
    <div class="card">
        <div class="card-header"><h5 class="card-title mb-0">Account</h5></div>
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FirstName" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="FirstName" class="form-control">
                    <span asp-validation-for="FirstName" class="text-danger fs-13"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="LastName" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="LastName" class="form-control">
                    <span asp-validation-for="LastName" class="text-danger fs-13"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="Email" class="form-control" autocomplete="off">
                    <span asp-validation-for="Email" class="text-danger fs-13"></span>
                </div>
                <div class="col-md-6"></div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Password" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="Password" class="form-control" autocomplete="new-password">
                    <span asp-validation-for="Password" class="text-danger fs-13"></span>
                    <div class="form-text">At least 8 characters. The user is not forced to change it.</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password">
                    <span asp-validation-for="ConfirmPassword" class="text-danger fs-13"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5 class="card-title mb-0">Access</h5></div>
        <div class="card-body">
            <partial name="_AccessFields" model="Model" />
        </div>
    </div>

    <div class="d-flex gap-2 mb-4">
        <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>Create User</button>
        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
