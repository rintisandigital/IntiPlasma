@model UserDetailsViewModel
@{
    Application.Users.GetById.UserResponse user = Model.User;
    ViewData["Title"] = $"{user.FirstName} {user.LastName}";
    ViewData["Menu"] = MenuCodes.AdminUsers;
}
<div class="page-header">
    <div class="add-item d-flex">
        <div class="page-title">
            <h4 class="fw-bold">@user.FirstName @user.LastName</h4>
            <h6>@user.Email</h6>
        </div>
    </div>
    <div class="page-btn d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-light"><i class="ti ti-arrow-left me-1"></i>Back</a>
        <a asp-action="Edit" asp-route-id="@user.Id" asp-menu="@MenuCodes.AdminUsers" asp-right="Edit" class="btn btn-outline-primary">
            <i class="ti ti-edit me-1"></i>Edit
        </a>
        <a asp-controller="AuditLogs" asp-action="Index" asp-route-userId="@user.Id" asp-menu="@MenuCodes.AdminAuditLogs" class="btn btn-outline-secondary">
            <i class="ti ti-history me-1"></i>Audit Log
        </a>
        <a asp-action="Access" asp-route-id="@user.Id" asp-menu="@MenuCodes.AdminUsers" asp-right="Edit" class="btn btn-primary">
            <i class="ti ti-shield-lock me-1"></i>Change Access
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0">Account</h5></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        <partial name="Partials/_StatusBadge" model='user.IsActive ? "Active" : "Inactive"' />
                        @if (Model.IsLockedOut)
                        {
                            <span class="badge bg-danger ms-1">Locked until @Fmt.DateTime(user.LockoutEndUtc!.Value)</span>
                        }
                    </dd>
                    <dt class="col-sm-4">Failed sign-ins</dt>
                    <dd class="col-sm-8">@user.AccessFailedCount <span class="text-muted small">since the last successful sign-in</span></dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@user.Email</dd>
                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">@Fmt.DateTime(user.CreatedAtUtc)</dd>
                    <dt class="col-sm-4">Menu access</dt>
                    <dd class="col-sm-8">
                        @if (user.MenuAccessProfileId is Guid menuProfileId)
                        {
                            <a asp-controller="MenuAccess" asp-action="Details" asp-route-id="@menuProfileId">@user.MenuAccessProfileName</a>
                        }
                        else
                        {
                            <span class="text-danger">None — the user cannot sign in to the web app</span>
                        }
                    </dd>
                    <dt class="col-sm-4">Branch access</dt>
                    <dd class="col-sm-8">
                        @if (user.BranchAccessProfileId is Guid branchProfileId)
                        {
                            <a asp-controller="BranchAccess" asp-action="Details" asp-route-id="@branchProfileId">@user.BranchAccessProfileName</a>
                        }
                        else
                        {
                            <span class="text-danger">None — no branch data is visible</span>
                        }
                    </dd>
                    <dt class="col-sm-4">Default branch</dt>
                    <dd class="col-sm-8">@(user.DefaultBranchName ?? "— (first accessible branch)")</dd>
                    <dt class="col-sm-4">API roles</dt>
                    <dd class="col-sm-8">@(user.Roles.Count > 0 ? string.Join(", ", user.Roles) : "—")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0">Effective branches</h5></div>
            <div class="card-body">
                @if (user.AllBranches)
                {
                    <p class="mb-0"><i class="ti ti-world me-1 text-primary"></i>All branches, including branches created later.</p>
                }
                else if (user.Branches.Count == 0)
                {
                    <p class="mb-0 text-muted">No branch.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (Application.Users.GetById.UserBranchResponse branch in user.Branches)
                        {
                            <li class="mb-1"><span class="badge bg-light text-dark me-2">@branch.Code</span>@branch.Name</li>
                        }
                    </ul>
                }
            </div>
        </div>

        @if (!Model.IsCurrentUser)
        {
            <div class="card" asp-menu="@MenuCodes.AdminUsers" asp-right="Edit">
                <div class="card-header"><h5 class="card-title mb-0">Actions</h5></div>
                <div class="card-body d-flex flex-wrap gap-2">
                    @if (user.IsActive)
                    {
                        <form method="post" asp-action="Deactivate" asp-route-id="@user.Id" data-confirm="Deactivate this user? Their sessions end immediately.">
                            <button type="submit" class="btn btn-warning"><i class="ti ti-user-off me-1"></i>Deactivate</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-action="Activate" asp-route-id="@user.Id">
                            <button type="submit" class="btn btn-success"><i class="ti ti-user-check me-1"></i>Activate</button>
                        </form>
                    }
                    @if (Model.IsLockedOut)
                    {
                        <form method="post" asp-action="Unlock" asp-route-id="@user.Id">
                            <button type="submit" class="btn btn-success"><i class="ti ti-lock-open me-1"></i>Unlock</button>
                        </form>
                    }
                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#reset-password">
                        <i class="ti ti-key me-1"></i>Reset Password
                    </button>
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#delete-user"
                            asp-menu="@MenuCodes.AdminUsers" asp-right="Delete">
                        <i class="ti ti-trash me-1"></i>Delete
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="reset-password" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-action="ResetPassword" asp-route-id="@user.Id" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Reset password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label for="NewPassword" class="form-label">New password</label>
                <input type="password" id="NewPassword" name="NewPassword" class="form-control" minlength="8" required autocomplete="new-password">
                <div class="form-text">At least 8 characters. The user's sessions and mobile sign-ins end.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Reset Password</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="delete-user" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-action="Delete" asp-route-id="@user.Id" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete user</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Delete <strong>@user.Email</strong>? A backup copy is kept, but the user disappears from the application.</p>
                <label for="Reason" class="form-label">Reason (optional)</label>
                <textarea id="Reason" name="Reason" class="form-control" rows="2" maxlength="500"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger">Delete</button>
            </div>
        </form>
    </div>
</div>
