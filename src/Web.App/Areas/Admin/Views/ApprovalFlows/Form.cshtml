@using Web.App.Areas.Approvals.Models
@model ApprovalFlowFormViewModel
@{
    bool isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "Add Approval Flow" : $"Edit {Model.Name}";
    ViewData["Menu"] = MenuCodes.AdminApprovalFlows;
    bool canSave = isNew || await Rights.CanAsync(MenuCodes.AdminApprovalFlows, MenuRights.Edit);
}
<div class="page-header">
    <div class="add-item d-flex">
        <div class="page-title">
            <h4 class="fw-bold">@(isNew ? "Add Approval Flow" : "Edit Approval Flow")</h4>
            <h6>Levels are decided in order; any one approver of a level decides it. Changes apply to new requests only.</h6>
        </div>
    </div>
    <div class="page-btn">
        <a asp-action="Index" class="btn btn-light"><i class="ti ti-arrow-left me-1"></i>Back</a>
    </div>
</div>

<form asp-action="@(isNew ? "Create" : "Edit")" method="post" class="card">
    @if (isNew)
    {
        <form-token />
    }
    else
    {
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="DocumentType" />
        <input type="hidden" asp-for="BranchId" />
    }
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="DocumentType" class="form-label"></label> <span class="text-danger">*</span>
                <select asp-for="DocumentType" class="form-select" disabled="@(!isNew)" required>
                    <option value="">— choose —</option>
                    @foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem type in ApprovalLabels.DocumentTypeOptions(Model.DocumentType))
                    {
                        <option value="@type.Value" selected="@type.Selected">@type.Text</option>
                    }
                </select>
                <span asp-validation-for="DocumentType" class="text-danger fs-13"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="BranchId" class="form-label"></label>
                <select asp-for="BranchId" asp-items="Model.BranchOptions" class="form-select" disabled="@(!isNew)">
                    <option value="">Default (all branches)</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Peternak baru — Bandung">
            </div>
        </div>
        @if (!isNew)
        {
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" role="switch" id="IsActive" name="IsActive" value="true" checked="@(Model.IsActive == true)">
                <label class="form-check-label" for="IsActive">Active</label>
            </div>
        }
        <h6 class="mb-2">Levels</h6>
        <partial name="Partials/_ApprovalLevelsEditor" model='new ApprovalLevelsEditorModel("Levels", Model.Levels, Model.ApproverNames, "#BranchId")' />
    </div>
    <div class="card-footer">
        <partial name="Partials/_FormButtons" model='new FormButtonsModel(canSave, Url.Action("Index")!)' />
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
