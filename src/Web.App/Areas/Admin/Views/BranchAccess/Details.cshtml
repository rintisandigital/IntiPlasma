@model BranchAccessDetailsViewModel
@{
    Application.Access.BranchAccessProfiles.BranchAccessProfileResponse profile = Model.Profile;
    ViewData["Title"] = profile.Name;
    ViewData["Menu"] = MenuCodes.AdminBranchAccess;
}
<div class="page-header">
    <div class="add-item d-flex">
        <div class="page-title">
            <h4 class="fw-bold">
                @profile.Name
                @if (profile.IsSystem)
                {
                    <span class="badge bg-info ms-1 fs-12">System</span>
                }
            </h4>
            <h6>@(profile.Description ?? "Branch access profile") · used by @profile.UserCount user(s)</h6>
        </div>
    </div>
    <div class="page-btn d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-light"><i class="ti ti-arrow-left me-1"></i>Back</a>
        @if (!profile.IsSystem)
        {
            <a asp-action="Edit" asp-route-id="@profile.Id" asp-menu="@MenuCodes.AdminBranchAccess" asp-right="Edit" class="btn btn-primary">
                <i class="ti ti-edit me-1"></i>Edit
            </a>
            <form method="post" asp-action="Delete" asp-route-id="@profile.Id" asp-menu="@MenuCodes.AdminBranchAccess" asp-right="Delete"
                  data-confirm="Delete this branch access profile?">
                <button type="submit" class="btn btn-outline-danger"><i class="ti ti-trash me-1"></i>Delete</button>
            </form>
        }
    </div>
</div>

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">Branches</h5></div>
    <div class="card-body">
        @if (profile.AllBranches)
        {
            <p class="mb-0"><i class="ti ti-world me-1 text-primary"></i>All branches, including branches created later.</p>
        }
        else
        {
            <ul class="list-unstyled mb-0">
                @foreach (Application.Access.BranchAccessProfiles.BranchAccessProfileBranchItem branch in profile.Branches)
                {
                    <li class="mb-1 @(branch.IsActive ? "" : "text-muted")">
                        <span class="badge bg-light text-dark me-2">@branch.Code</span>@branch.Name
                        @if (!branch.IsActive)
                        {
                            <span class="badge bg-secondary ms-1">Inactive (ignored)</span>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</div>
