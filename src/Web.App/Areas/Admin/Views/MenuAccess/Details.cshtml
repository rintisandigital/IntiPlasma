@model MenuAccessFormViewModel
@{
    ViewData["Title"] = Model.Name;
    ViewData["Menu"] = MenuCodes.AdminMenuAccess;
}
<div class="page-header">
    <div class="add-item d-flex">
        <div class="page-title">
            <h4 class="fw-bold">
                @Model.Name
                @if (Model.IsSystem)
                {
                    <span class="badge bg-info ms-1 fs-12">System</span>
                }
            </h4>
            <h6>@(Model.Description ?? "Menu access profile") · used by @Model.UserCount user(s)</h6>
        </div>
    </div>
    <div class="page-btn d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-light"><i class="ti ti-arrow-left me-1"></i>Back</a>
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#duplicate-profile"
                asp-menu="@MenuCodes.AdminMenuAccess" asp-right="Create">
            <i class="ti ti-copy me-1"></i>Duplicate
        </button>
        @if (!Model.IsSystem)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" asp-menu="@MenuCodes.AdminMenuAccess" asp-right="Edit" class="btn btn-primary">
                <i class="ti ti-edit me-1"></i>Edit
            </a>
            <form method="post" asp-action="Delete" asp-route-id="@Model.Id" asp-menu="@MenuCodes.AdminMenuAccess" asp-right="Delete"
                  data-confirm="Delete this menu access profile?">
                <button type="submit" class="btn btn-outline-danger"><i class="ti ti-trash me-1"></i>Delete</button>
            </form>
        }
    </div>
</div>

@if (Model.IsSystem)
{
    <div class="alert alert-info"><i class="ti ti-info-circle me-1"></i>Full Access grants every right on every menu, including menus added later. It cannot be changed.</div>
}

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">Rights</h5></div>
    <div class="card-body p-0">
        <partial name="_Matrix" model="Model" view-data='new ViewDataDictionary(ViewData) { ["ReadOnly"] = true }' />
    </div>
</div>

<div class="modal fade" id="duplicate-profile" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-action="Duplicate" asp-route-id="@Model.Id" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Duplicate "@Model.Name"</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label for="DuplicateName" class="form-label">Name of the copy</label>
                <input id="DuplicateName" name="Name" class="form-control" maxlength="100" required value="@Model.Name (copy)">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Duplicate</button>
            </div>
        </form>
    </div>
</div>
