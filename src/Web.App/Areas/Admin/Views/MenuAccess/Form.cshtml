@model MenuAccessFormViewModel
@{
    bool isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "Add Menu Access" : $"Edit {Model.Name}";
    ViewData["Menu"] = MenuCodes.AdminMenuAccess;
}
<div class="page-header">
    <div class="add-item d-flex">
        <div class="page-title">
            <h4 class="fw-bold">@(isNew ? "Add Menu Access" : "Edit Menu Access")</h4>
            <h6>Tick the rights of each menu; any right includes View</h6>
        </div>
    </div>
    <div class="page-btn">
        @if (isNew)
        {
            <a asp-action="Index" class="btn btn-light"><i class="ti ti-arrow-left me-1"></i>Back</a>
        }
        else
        {
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light"><i class="ti ti-arrow-left me-1"></i>Back</a>
        }
    </div>
</div>

<form asp-action="@(isNew ? "Create" : "Edit")" method="post">
    @if (isNew)
    {
        <form-token />
    }
    else
    {
        <input type="hidden" asp-for="Id" />
    }
    <div class="card">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <div class="row">
                <div class="col-md-5 mb-3">
                    <label asp-for="Name" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Finance Staff">
                    <span asp-validation-for="Name" class="text-danger fs-13"></span>
                </div>
                <div class="col-md-7 mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control">
                </div>
            </div>
            @if (!isNew && Model.UserCount > 0)
            {
                <p class="text-muted fs-13 mb-0"><i class="ti ti-info-circle me-1"></i>Used by @Model.UserCount user(s); changes apply to them immediately.</p>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5 class="card-title mb-0">Rights</h5></div>
        <div class="card-body p-0">
            <partial name="_Matrix" model="Model" />
        </div>
    </div>

    <div class="d-flex gap-2 mb-4">
        <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>Save</button>
        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </div>
</form>
