@model ApiRoleFormViewModel
@{
    bool isNew = Model.Id is null;
    bool canEdit = !Model.IsSystem && await Rights.CanAsync(MenuCodes.AdminApiRoles, isNew ? MenuRights.Create : MenuRights.Edit);
    ViewData["Title"] = isNew ? "Add Role" : Model.Name;
    ViewData["Menu"] = MenuCodes.AdminApiRoles;
}
<div class="page-header">
    <div class="add-item d-flex">
        <div class="page-title">
            <h4 class="fw-bold">@(isNew ? "Add Role" : Model.Name)</h4>
            <h6>API permissions (Web.Api / mobile)</h6>
        </div>
    </div>
    <div class="page-btn">
        <a asp-action="Index" class="btn btn-light"><i class="ti ti-arrow-left me-1"></i>Back</a>
    </div>
</div>

@if (Model.IsSystem)
{
    <div class="alert alert-info"><i class="ti ti-info-circle me-1"></i>The Administrator role always has every permission and cannot be changed.</div>
}

<form asp-action="@(isNew ? "Create" : "Edit")" method="post">
    @if (isNew)
    {
        <form-token />
    }
    else
    {
        <input type="hidden" asp-for="Id" />
    }
    <fieldset disabled="@(!canEdit)">
        <div class="card">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                <div class="row">
                    <div class="col-md-5 mb-3">
                        <label asp-for="Name" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="Name" class="form-control">
                        <span asp-validation-for="Name" class="text-danger fs-13"></span>
                    </div>
                    <div class="col-md-7 mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <input asp-for="Description" class="form-control">
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0">Permissions</h5></div>
            <div class="card-body">
                <div class="row">
                    @foreach (IGrouping<string, string> module in ApiRoleFormViewModel.Catalog)
                    {
                        <div class="col-md-4 mb-3">
                            <h6 class="fw-semibold text-capitalize mb-2">@module.Key.Replace('-', ' ')</h6>
                            @foreach (string permission in module)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="Permissions" value="@permission"
                                           id="perm-@permission.Replace(':', '-')" checked="@Model.Permissions.Contains(permission)">
                                    <label class="form-check-label" for="perm-@permission.Replace(':', '-')">@permission.Split(':')[1]</label>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </fieldset>

    @if (canEdit)
    {
        <div class="d-flex gap-2 mb-4">
            <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>Save</button>
            <a asp-action="Index" class="btn btn-light">Cancel</a>
        </div>
    }
</form>
