@model ApprovalDetailsViewModel
@{
    ApprovalRequestResponse request = Model.Detail.Request;
    ViewData["Title"] = $"Approval {request.DocumentCode}";
    ViewData["Menu"] = Model.CanReassign || ViewContext.RouteData.Values["controller"] as string == "Requests"
        ? MenuCodes.ApprovalsRequests
        : MenuCodes.ApprovalsInbox;
    string? documentUrl = ApprovalLabels.DocumentUrl(request.DocumentType, request.DocumentId);
    ApprovalLevelResponse? pendingLevel = Model.Detail.Levels.FirstOrDefault(l => l.State == "Pending");
}
<div class="page-header">
    <div class="add-item d-flex">
        <div class="page-title">
            <h4 class="fw-bold">@ApprovalLabels.DocumentType(request.DocumentType) <partial name="Partials/_StatusBadge" model="request.Status" /></h4>
            <h6>@request.DocumentCode — @request.DocumentTitle · @request.BranchName</h6>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a href="@Model.ReturnUrl" class="btn btn-light"><i class="ti ti-arrow-left me-1"></i>Back</a>
        @if (documentUrl is not null)
        {
            <a href="@documentUrl" class="btn btn-outline-primary"><i class="ti ti-file-text me-1"></i>Open document</a>
        }
    </div>
</div>

@if (Model.Detail.CanDecide)
{
    <div class="card border-primary">
        <div class="card-header"><h5 class="card-title mb-0">Your decision · @ApprovalLabels.Level(request)</h5></div>
        <div class="card-body">
            @if (Model.Detail.DecidesOnBehalfOf is { } onBehalf)
            {
                <div class="alert alert-info">You decide on behalf of <strong>@onBehalf</strong> (delegation).</div>
            }
            <div class="d-flex flex-wrap gap-3 align-items-end">
                <form action="/Approvals/Inbox/Approve/@request.Id" method="post" class="flex-grow-1" data-confirm="Approve level @request.CurrentLevel of @request.DocumentCode?">
                    @Html.AntiForgeryToken()
                    <label for="note" class="form-label">Note (optional)</label>
                    <div class="input-group">
                        <input id="note" name="note" maxlength="500" class="form-control" />
                        <button type="submit" class="btn btn-success"><i class="ti ti-check me-1"></i>Approve</button>
                    </div>
                </form>
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#reject-modal"><i class="ti ti-x me-1"></i>Reject</button>
            </div>
        </div>
    </div>
    <partial name="Partials/_ReasonModal" model='new ReasonModalModel("reject-modal", $"Reject {request.DocumentCode}", $"/Approvals/Inbox/Reject/{request.Id}", "Reject")' />
}

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">Timeline</h5></div>
    <div class="card-body">
        <partial name="Partials/_ApprovalTimeline" model="new ApprovalTimelineModel([Model.Detail], ShowActions: Model.Detail.CanCancel)" />
    </div>
</div>

@if (Model.CanReassign && pendingLevel is not null)
{
    <div class="card">
        <div class="card-header"><h5 class="card-title mb-0">Replace an approver of a level still to be decided</h5></div>
        <div class="card-body">
            <form asp-action="Reassign" asp-route-id="@request.Id" method="post" class="row g-2 align-items-end" data-confirm="Replace this approver on this request?">
                <div class="col-md-2">
                    <label class="form-label" for="levelNo">Level</label>
                    <select id="levelNo" name="levelNo" class="form-select">
                        @foreach (ApprovalLevelResponse level in Model.Detail.Levels.Where(l => l.LevelNo >= request.CurrentLevel))
                        {
                            <option value="@level.LevelNo">@level.LevelNo · @level.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="fromUserId">Approver</label>
                    <select id="fromUserId" name="fromUserId" class="form-select">
                        @foreach (ApproverResponse approver in Model.Detail.Levels.Where(l => l.LevelNo >= request.CurrentLevel).SelectMany(l => l.Approvers).DistinctBy(a => a.UserId))
                        {
                            <option value="@approver.UserId">@approver.Name@(approver.CanDecide ? string.Empty : " (inactive)")</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="toUserId">Replace with</label>
                    <select id="toUserId" name="toUserId" class="form-select" asp-items="Model.Candidates"></select>
                </div>
                <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Replace</button></div>
            </form>
        </div>
    </div>
}
