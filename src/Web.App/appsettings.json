{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "User ID =postgres;Password=admin;Server=localhost;Port=5432;Database=intiplasma;"
  },
  "App": {
    "Name": "Inti-Plasma",
    "CompanyName": "PT. Rintisan Digital Indopiranti",
    "FormatCulture": "id-ID",
    "TimeZone": "Asia/Jakarta"
  },
  "BackgroundJobs": {
    "Enabled": true
  },
  "Outbox": {
    "IntervalInSeconds": 5,
    "BatchSize": 50,
    "MaxAttempts": 5
  },
  "FileStorage": {
    "RootPath": "uploads",
    "OrphanRetentionHours": 24,
    "CleanupIntervalMinutes": 60,
    "CleanupBatchSize": 100
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
