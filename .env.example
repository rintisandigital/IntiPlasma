# Copy to .env next to docker-compose.yml and fill in. .env is ignored by git and by the image build.
# Variables without "__" are used by docker-compose itself; "Section__Key" variables are application settings
# passed to Web.Api and Web.App (they override appsettings.json). See docs/DEPLOY.md.

# --- docker-compose ---
POSTGRES_DB=intiplasma
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
WEB_API_PORT=5000
WEB_APP_PORT=5002

# --- both applications ---
ASPNETCORE_ENVIRONMENT=Production
App__CompanyName=PT. Rintisan Digital Indopiranti
App__TimeZone=Asia/Jakarta
Security__Lockout__MaxFailedAttempts=5
Security__Lockout__LockoutMinutes=15

# --- Web.Api (JWT for the mobile app) ---
Jwt__Secret=change-me-to-a-random-string-of-at-least-32-characters
Jwt__Issuer=intiplasma
Jwt__Audience=intiplasma-mobile
Jwt__ExpirationInMinutes=60

# --- Web.App ---
# Behind a reverse proxy that terminates TLS: trust its X-Forwarded-For/Proto headers.
Security__TrustForwardedHeaders=true
# Cookies only over HTTPS. Set to false only when the web app is served over plain HTTP (not recommended).
Security__SecureCookies=true
Security__LoginPermitPerMinute=10
